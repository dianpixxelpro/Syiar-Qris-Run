  }
  
  .add-participant-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-sm {
    padding: 0.55rem 1rem;
    font-size: 0.9rem;
    border-radius: 0.75rem;
  }

  .btn-outline {
    background: #f8fafc;
    color: #111827;
    border-color: rgba(148, 163, 184, 0.85);
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.08);
  }

  .btn-outline:hover {
    background: #e2e8f0;
