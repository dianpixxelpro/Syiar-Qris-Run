---
import Layout from '../../layouts/Layout.astro';
import { getEventById, createRegistration, updateRegistrationAmount } from '../../lib/db';
import { encryptId } from '../../lib/crypto';

const { id } = Astro.params;
const eventId = parseInt(id || '', 10);

if (isNaN(eventId)) {
  return Astro.redirect('/');
}

const event = await getEventById(eventId);

const isRegistrationFinished = true;
if (!event || isRegistrationFinished) {
  return Astro.redirect('/');
}

const registrationOpenDate = new Date('2026-07-31T08:00:00+07:00');
const isRegistrationOpen = new Date() >= registrationOpenDate;

let errorMsg = '';

if (Astro.request.method === 'POST') {
  if (!isRegistrationOpen) {
    errorMsg = 'Pendaftaran belum dibuka. Silakan kembali pada 31 Juli 2026 pukul 08:00 WIB.';
  } else {
    try {
      const formData = await Astro.request.formData();
      const email = formData.get('email')?.toString() || '';
      const phone = formData.get('phone')?.toString() || '';

      // Parse collective participants
      const participants = [];
      let i = 1;
      while (formData.has(`name_${i}`)) {
        participants.push({
          name: formData.get(`name_${i}`)?.toString() || '',
          jenisKelamin: formData.get(`jenisKelamin_${i}`)?.toString() || '',
          jenisId: formData.get(`jenisId_${i}`)?.toString() || '',
          nomorId: formData.get(`nomorId_${i}`)?.toString() || '',
          ukuranJersey: formData.get(`ukuranJersey_${i}`)?.toString() || ''
        });
        i++;
      }

      if (participants.length === 0 || !email || !phone) {
        errorMsg = 'Data peserta, email, dan nomor WhatsApp wajib diisi!';
      } else if (event.registered + participants.length > event.slots) {
        errorMsg = 'Maaf, sisa kuota pendaftaran tidak mencukupi untuk jumlah peserta ini.';
      } else {
        // Gunakan harga asli event dari database
        const basePrice = 81000; // event.price;
        const totalBase = basePrice * participants.length;

        // Store participants as JSON string in the name field to avoid DB schema changes
        const nameField = JSON.stringify(participants);

        // Buat pendaftaran baru dengan status PENDING
        const regId = await createRegistration({
          eventId: event.id,
          name: nameField,
          email,
          phone,
          status: 'PENDING',
          amount: totalBase,
          paymentMethod: 'QRIS',
          checkedIn: false
        });

        if (regId) {
          // Gunakan ID Registrasi sebagai kode unik (mulai dari 1)
          const uniqueCode = regId;
          const finalAmount = totalBase + uniqueCode;
          await updateRegistrationAmount(regId, finalAmount);
          
          return Astro.redirect(`/checkout/${encryptId(regId)}`);
        } else {
          errorMsg = 'Gagal memproses pendaftaran. Silakan coba lagi.';
        }
      }
    } catch (err) {
      errorMsg = 'Terjadi kesalahan saat memproses pendaftaran.';
      console.error(err);
    }
  }
}

// Formatting helpers
const formatDate = (dateStr: string) => {
  const options: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
  return new Date(dateStr).toLocaleDateString('id-ID', options);
};

const formatPrice = (price: number) => {
  if (price === 0) return 'Gratis';
  return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(price);
};

const isFull = event.registered >= event.slots;
const isFinished = event.status === 'FINISHED';
---

<Layout
  title={`${event.title} - Pendaftaran Resmi`}
  description={`Daftar ${event.title} di Kediri Town Square pada 16 Agustus 2026. Harga tiket Rp 81.000 dengan benefit Jersey, Medali Finisher, BIB, dan Doorprize.`}
  image="/gambar-banner.webp"
  schemaType="Event"
>
  <section class="event-detail-section">
    
    <div class="container relative z-1">
      <!-- <a href="/" class="back-link">&larr; Kembali ke Beranda</a> -->
      
      <!-- Kolom Info Atas (Full Width) -->
      <div class="info-column" style="margin-bottom: 2rem;">
        <div class="banner-wrapper glass">
          <img src="/gambar-banner.webp" alt={event.title} class="detail-banner" width="1200" height="320" fetchpriority="high" />
          <span class={`badge badge-${event.category.toLowerCase()} detail-badge`}>{event.category}</span>
        </div>
      </div>

      <form method="POST" class="reg-form" id="reg-form">
        <div class="detail-grid">
          
          <!-- Kolom Registrasi Kiri -->
          <div class="reg-column">
            <div class="reg-card glass">
              
              <div class="kuota-info">
                <div class="kuota-label">
                  <span>Data Peserta yang berhasil upload bukti pembayaran</span>
                  <span>{event.registered} / {event.slots} Slot</span>
                </div>
                <div class="progress-bar">
                  <div class="progress-fill" style={`width: ${Math.min((event.registered / (event.slots || 1500)) * 100, 100)}%;`}></div>
                </div>
              </div>

              {isFinished ? (
                <div class="status-alert alert-danger text-center">
                  <strong>Event Telah Selesai</strong>
                  <p>Pendaftaran sudah ditutup untuk event ini.</p>
                </div>
              ) : !isRegistrationOpen ? (
                <div class="status-alert alert-danger text-center" style="padding: 2rem;">
                  <strong>Pendaftaran Belum Dibuka</strong>
                  <p style="margin-top: 0.5rem; font-size: 1.1rem;">Pendaftaran akan dibuka pada tanggal 31 Juli 2026 pukul 08:00 WIB.</p>
                </div>
              ) : isFull ? (
                <div class="status-alert alert-danger text-center">
                  <strong>Kuota Sementara Terpenuhi</strong>
                  <p>Maaf, Pendaftaran Sementara ditutup untuk verifikasi data pendaftar yang telah masuk.</p>
                </div>
              ) : (
                <div class="form-wrapper">
                  <h3>Formulir Pendaftaran</h3>
                  {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}
                  
                  <div class="participant-container" id="participants-container">
                    <!-- Participant 1 -->
                    <div class="participant-block" data-index="1">
                      <h4 class="form-section-title">Data Peserta</h4>
                      
                      <div class="form-group">
                        <label for="name_1">Nama Lengkap (Sesuai ID)</label>
                        <input type="text" id="name_1" name="name_1" required placeholder="Isi Nama sesuai ID Card Anda" />
                      </div>
                      
                      <div class="form-row mt-3">
                        <div class="form-group half">
                          <label for="jenisKelamin_1">Jenis Kelamin</label>
                          <select id="jenisKelamin_1" name="jenisKelamin_1" required>
                            <option value="Pria">Pria</option>
                            <option value="Wanita">Wanita</option>
                          </select>
                        </div>
                        <div class="form-group half">
                          <label for="jenisId_1">Jenis ID</label>
                          <select id="jenisId_1" name="jenisId_1" required>
                            <option value="KTP">KTP</option>
                            <option value="SIM">SIM</option>
                            <option value="Paspor">Paspor</option>
                            <option value="Kartu Pelajar">Kartu Pelajar</option>
                          </select>
                        </div>
                      </div>

                      <div class="form-group mt-3">
                        <label for="nomorId_1">Nomor ID</label>
                        <input type="text" id="nomorId_1" name="nomorId_1" required placeholder="Isi dengan Nomor NIK Anda" />
                      </div>

                      
                    </div>
                  </div>


                  <input type="hidden" id="jumlah_peserta" name="jumlah_peserta" value="1" />
                  
                  <hr style="border-color: rgba(255,255,255,0.1); margin: 2rem 0;" />
                  
                  <h4 class="form-section-title">Panduan Ukuran Jersey</h4>
                  <div class="jersey-preview-card mt-3">
                    <div class="jersey-preview-grid">
                      <div class="jersey-preview-item">
                        <img src="/jersey-placeholder.webp" alt="Jersey Depan" class="jersey-thumb" width="400" height="240" loading="lazy" />
                        <span class="jersey-caption">Depan Jersey</span>
                      </div>
                      <div class="jersey-preview-item">
                        <img src="/jersey-back-placeholder.webp" alt="Jersey Belakang" class="jersey-thumb" width="400" height="240" loading="lazy" />
                        <span class="jersey-caption">Belakang Jersey</span>
                      </div>
                    </div>
                  </div>
                  <div class="size-chart-compact mt-2 mb-4">
                    <table class="compact-table">
                      <thead>
                        <tr><th>Size</th><th>Lebar (cm)</th><th>Panjang (cm)</th></tr>
                      </thead>
                      <tbody>
                        <tr><td>S</td><td>47</td><td>68</td></tr>
                        <tr><td>M</td><td>50</td><td>70</td></tr>
                        <tr><td>L</td><td>53</td><td>72</td></tr>
                        <tr><td>XL</td><td>56</td><td>74</td></tr>
                        <tr><td>XXL</td><td>59</td><td>76</td></tr>
                      </tbody>
                    </table>
                  </div>

                  <div id="jersey-dropdowns-container">
                    <div class="form-group mt-3 jersey-select-block" data-index="1">
                      <label for="ukuranJersey_1">Ukuran Jersey</label>
                      <select id="ukuranJersey_1" name="ukuranJersey_1" required>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="XXL">XXL</option>
                      </select>
                    </div>
                  </div>

                  <h4 class="form-section-title mt-4">Data Kontak (Pemesan)</h4>
                  <div class="form-row">
                    <div class="form-group half">
                      <label for="email">Email Pemesan (Wajib diisi)</label>
                      <input type="email" id="email" name="email" required placeholder="Pastikan Email Sesuai" />
                    </div>
                    <div class="form-group half">
                      <label for="phone">Nomor WhatsApp</label>
                      <input type="tel" id="phone" name="phone" required placeholder="08..." />
                    </div>
                  </div>
                  <div class="terms-group mt-4 pt-3" style="border-top: 1px dashed rgba(255,255,255,0.2);">
                    <label class="checkbox-label">
                      <input type="checkbox" name="terms" required />
                      <span>Saya menyetujui <a href="/regulasi" target="_blank" class="terms-link">syarat dan ketentuan</a>.</span>
                    </label>
                  </div>
                </div>
              )}
            </div>
          </div>
          
          <!-- Kolom Ringkasan Kanan (Sticky) -->
          {!isFinished && !isFull && isRegistrationOpen && (
            <div class="summary-column">
              <div class="reg-card glass">
                <div class="price-header" style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px dashed rgba(255,255,255,0.2);">
                  <span class="label">Biaya Pendaftaran</span>
                  <span class="value price-tag">{formatPrice(81000)}</span>
                  <span style="font-size: 0.85rem; color: #64748b; margin-top: 0.25rem;">(Termasuk <strong>Wakaf Produktif</strong> sebesar Rp 30.000)</span>

                </div>
                
                <h4 class="form-section-title">Ringkasan Pesanan</h4>
                <div class="category-card selected mt-3">
                  <div class="category-info">
                    <span class="cat-name">{event.title}</span>
                    <span class="cat-price text-accent" id="summary-price" data-price={81000}>{formatPrice(81000)}</span>
                  </div>
                  <div class="category-badge">
                    <span class="badge-text">{event.category}</span>
                  </div>
                </div>
                
                <div class="summary-extra" style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-top: 1rem; border-top: 1px dashed rgba(255,255,255,0.2); padding-top: 1rem;">
                  <span class="text-secondary">Fasilitas Jersey</span>
                  <span style="color: var(--success); font-weight: 600;">TERMASUK</span>
                </div>
                
                <button type="submit" class="btn btn-accent btn-block submit-btn mt-4">Konfirmasi Pesanan</button>
              </div>
            </div>
          )}
        </div>

        <!-- Sticky Mobile Bottom Bar -->
        {!isFinished && !isFull && isRegistrationOpen && (
          <div class="mobile-sticky-submit" id="mobile-sticky-submit">
            <div class="sticky-price-info">
              <span class="sticky-label">Total Biaya (<span id="sticky-qty">1</span> Peserta)</span>
              <span class="sticky-price" id="sticky-price">{formatPrice(81000)}</span>
              <span class="sticky-note">(Termasuk <strong>Wakaf Produktif</strong> Rp 30.000)</span>
            </div>
            <button type="submit" class="btn btn-accent btn-sticky">Konfirmasi Pesanan</button>
          </div>
        )}
      </form>

      <script>
                  document.addEventListener('DOMContentLoaded', () => {
                    const container = document.getElementById('participants-container');
                    const addBtn = document.getElementById('add-participant-btn');
                    const removeBtn = document.getElementById('remove-participant-btn');
                    const qtySpan = document.getElementById('summary-qty');
                    const priceSpan = document.getElementById('summary-price');
                    const qtyInput = document.getElementById('jumlah_peserta') as HTMLInputElement | null;
                    
                    let participantCount = 1;
                    const basePrice = priceSpan ? parseInt(priceSpan.getAttribute('data-price') || '0', 10) : 0;
                    
                    function formatRupiah(angka: number) {
                      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
                    }
                    
                    function updateSummary() {
                      if (qtySpan) qtySpan.textContent = participantCount.toString();
                      if (priceSpan) priceSpan.textContent = formatRupiah(participantCount * basePrice);
                      if (qtyInput) qtyInput.value = participantCount.toString();
                      
                      const stickyQty = document.getElementById('sticky-qty');
                      const stickyPrice = document.getElementById('sticky-price');
                      if (stickyQty) stickyQty.textContent = participantCount.toString();
                      if (stickyPrice) stickyPrice.textContent = formatRupiah(participantCount * basePrice);
                      
                      if (removeBtn) {
                        if (participantCount > 1) {
                          removeBtn.style.display = 'inline-block';
                        } else {
                          removeBtn.style.display = 'none';
                        }
                      }
                    }
                    
                    // Sticky Mobile Bottom Bar Logic
                    const mobileSticky = document.getElementById('mobile-sticky-submit') as HTMLElement | null;
                    const summaryColumn = document.querySelector('.summary-column');
                    const floatingWa = document.querySelector('.floating-wa') as HTMLElement | null;

                    if (mobileSticky && summaryColumn) {
                      const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                          if (entry.isIntersecting) {
                            mobileSticky.style.opacity = '0';
                            mobileSticky.style.pointerEvents = 'none';
                            mobileSticky.style.transform = 'translateY(100%)';
                            if (floatingWa && window.innerWidth <= 991) {
                              floatingWa.style.transform = 'translateY(0)';
                            }
                          } else {
                            mobileSticky.style.opacity = '1';
                            mobileSticky.style.pointerEvents = 'auto';
                            mobileSticky.style.transform = 'translateY(0)';
                            if (floatingWa && window.innerWidth <= 991) {
                              floatingWa.style.transform = 'translateY(-100px)';
                            }
                          }
                        });
                      }, {
                        root: null,
                        threshold: 0.1
                      });
                      observer.observe(summaryColumn);
                    }
                  });
                </script>

    </div>
  </section>
</Layout>

