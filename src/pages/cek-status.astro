---
import Layout from "../layouts/Layout.astro";

// Blokir akses langsung ke halaman cek status via URL karena pendaftaran sudah selesai
return Astro.redirect('/');
---

<Layout title="Cek Status Pendaftaran">
  <section class="cek-status-section">
    <div class="container max-width-sm text-center">
      <h1 class="page-title">Pendaftaran Selesai</h1>
      <p class="page-desc">Halaman cek status pendaftaran telah ditutup.</p>
    </div>
  </section>
</Layout>
