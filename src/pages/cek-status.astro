---
import Layout from "../layouts/Layout.astro";
import { findRegistrationForUpload } from "../lib/db";
import { showSelamatCard } from "../config";

// Jika card selamat sudah muncul (artinya project/event sudah selesai total), blokir akses ke cek status
if (showSelamatCard) {
  return Astro.redirect('/');
}

let errorMsg = '';
let email = '';
let name = '';
let phone = '';
let nomorId = '';
let amount = '';
let paidRegistration: any = null;
let participantsList: any[] = [];

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  email = (formData.get('email') as string || '').trim();
  name = (formData.get('name') as string || '').trim();
  phone = (formData.get('phone') as string || '').trim();
  nomorId = (formData.get('nomorId') as string || '').trim();
  amount = (formData.get('amount') as string || '').trim();

  if (email && name && phone && nomorId && amount) {
    const amountNum = parseInt(amount, 10);
    const reg = await findRegistrationForUpload(email, phone, name, nomorId, amountNum);
    
    if (reg && reg.status === 'PAID') {
      paidRegistration = reg;
      try {
        const parsed = JSON.parse(reg.name);
        if (Array.isArray(parsed)) {
          participantsList = parsed;
        } else {
          participantsList = [{ name: reg.name, nomorId }];
        }
      } catch (e) {
        participantsList = [{ name: reg.name, nomorId }];
      }
    } else if (reg && reg.status !== 'PAID') {
      errorMsg = 'Status pendaftaran Anda belum terkonfirmasi Lunas. Cek status hanya diperuntukkan bagi peserta yang sudah terverifikasi Lunas.';
    } else {
      errorMsg = 'Data pendaftaran tidak ditemukan. Pastikan 5 data yang dimasukkan persis sama dengan saat pendaftaran.';
    }
  } else {
    errorMsg = 'Mohon lengkapi semua kolom.';
  }
}
---

<Layout title="Cek Status Pendaftaran">
  <section class="cek-status-section">
    <div class="container max-width-sm">
      {paidRegistration ? (
        <div class="form-card glass text-center">
          <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">🎉</div>
          <h1 class="page-title text-success" style="color: #4ade80; font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem;">
            Anda Sudah Terdaftar!
          </h1>
          <p class="page-desc mb-4" style="color: #cbd5e1; font-size: 0.95rem;">
            Pendaftaran dan pembayaran Anda telah terverifikasi <strong style="color: #4ade80;">LUNAS (PAID)</strong>.
          </p>

          <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 1.25rem; text-align: left; margin-bottom: 1.5rem;">
            <div style="margin-bottom: 0.75rem;">
              <span style="color: var(--text-secondary); font-size: 0.85rem; display: block;">Email Pemesan:</span>
              <strong style="color: white; font-size: 0.95rem;">{paidRegistration.email}</strong>
            </div>
            <div style="margin-bottom: 0.75rem;">
              <span style="color: var(--text-secondary); font-size: 0.85rem; display: block;">WhatsApp:</span>
              <strong style="color: white; font-size: 0.95rem;">{paidRegistration.phone}</strong>
            </div>
            <div>
              <span style="color: var(--text-secondary); font-size: 0.85rem; display: block; margin-bottom: 0.25rem;">Peserta Terdaftar:</span>
              {participantsList.map((p: any, idx: number) => (
                <div style="background: rgba(255,255,255,0.05); padding: 0.5rem 0.75rem; border-radius: 6px; margin-top: 0.35rem; font-size: 0.9rem;">
                  <strong style="color: #60a5fa;">{idx + 1}. {p.name}</strong> {p.nomorId ? `(${p.nomorId})` : ''}
                </div>
              ))}
            </div>
          </div>

          <a href={`/ticket/${paidRegistration.id}`} class="btn btn-accent btn-full mb-4" style="font-weight: 700;">
            Lihat E-Tiket
          </a>

          <!-- Alert Peringatan Email Spam & Contact Admin -->
          <div style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3); border-left: 4px solid #f59e0b; padding: 1rem 1.25rem; border-radius: 10px; text-align: left; margin-top: 1.25rem; margin-bottom: 1.25rem;">
            <strong style="color: #fbbf24; display: block; font-size: 0.9rem; margin-bottom: 0.35rem;">
              ⚠️ PENTING UNTUK PESERTA TERDAFTAR:
            </strong>
            <p style="color: #e2e8f0; font-size: 0.85rem; line-height: 1.5; margin-bottom: 0.5rem;">
              Mohon untuk mengecek folder <strong>Spam / Junk / Promosi</strong> pada email Anda jika E-Tiket atau konfirmasi tidak ditemukan di halaman <strong>Kotak Masuk (Inbox)</strong>.
            </p>
            <p style="color: #cbd5e1; font-size: 0.85rem; line-height: 1.5; margin: 0;">
              Jika email konfirmasi belum ada juga, silakan hubungi <a href="/kontak" style="color: #60a5fa; text-decoration: underline; font-weight: 600;">Admin Customer Service Kami</a>.
            </p>
          </div>

          <a href="/cek-status" class="btn btn-outline btn-full" style="font-size: 0.9rem;">
            Cek Status Lainnya
          </a>
        </div>
      ) : (
        <div class="form-card glass">
          <h1 class="page-title text-center">Cek Status Pendaftaran</h1>
          <p class="page-desc text-center mb-4">
            Masukkan data pendaftaran Anda untuk mengecek status konfirmasi lunas.
          </p>

          {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}

          <form method="POST" class="status-form">
            <div class="form-group">
              <label for="email">Email Pemesan</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-control"
                value={email}
                required
                placeholder="Contoh: budi@email.com"
              />
            </div>
            <div class="form-group mt-3">
              <label for="phone">Nomor WhatsApp Pemesan</label>
              <input
                type="text"
                id="phone"
                name="phone"
                class="form-control"
                value={phone}
                required
                placeholder="Contoh: 081234567890"
              />
            </div>
            <div class="form-group mt-3">
              <label for="name">Nama Lengkap Peserta</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                value={name}
                required
                placeholder="Sesuai pendaftaran"
              />
            </div>
            <div class="form-group mt-3">
              <label for="nomorId">Nomor Identitas (KTP/SIM) Peserta</label>
              <input
                type="text"
                id="nomorId"
                name="nomorId"
                class="form-control"
                value={nomorId}
                required
                placeholder="Sesuai pendaftaran"
              />
            </div>
            <div class="form-group mt-3">
              <label for="amount">Total Bayar (Termasuk Kode Unik)</label>
              <input
                type="number"
                id="amount"
                name="amount"
                class="form-control"
                value={amount}
                required
                placeholder="Contoh: 81001"
              />
            </div>
            <br />
            <button type="submit" class="btn btn-primary btn-full mt-4">
              Cek Status Terdaftar
            </button>
          </form>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .cek-status-section {
    padding: 6rem 0;
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .max-width-sm {
    max-width: 520px;
    width: 100%;
    margin: 0 auto;
  }
  .form-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
  }
  .page-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .alert {
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }
  .alert-danger {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }
  .status-form {
    display: flex;
    flex-direction: column;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: white;
    font-family: inherit;
    transition: all 0.3s ease;
  }
  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(0, 229, 255, 0.2);
  }
  .btn-full {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
  }
</style>
