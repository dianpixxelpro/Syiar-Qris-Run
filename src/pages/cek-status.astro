---
import Layout from '../layouts/Layout.astro';
import { findRegistrationForUpload } from '../lib/db';

let errorMsg = '';
let email = '';
let name = '';
let phone = '';
let nomorId = '';
let amount = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  email = (formData.get('email') as string || '').trim();
  name = (formData.get('name') as string || '').trim();
  phone = (formData.get('phone') as string || '').trim();
  nomorId = (formData.get('nomorId') as string || '').trim();
  amount = (formData.get('amount') as string || '').trim();

  if (email && name && phone && nomorId && amount) {
    const amountNum = parseInt(amount, 10);
    const reg = await findRegistrationForUpload(email, phone, name, nomorId, amountNum);
    
    if (reg) {
      if (reg.status === 'PAID') {
        return Astro.redirect(`/ticket/${reg.id}`);
      } else {
        return Astro.redirect(`/checkout/${reg.id}?from=cek-status`);
      }
    } else {
      errorMsg = 'Data tidak ditemukan atau tidak cocok. Pastikan 5 data yang dimasukkan persis sama dengan saat pendaftaran (termasuk 3 digit nominal unik jika ada).';
    }
  } else {
    errorMsg = 'Mohon lengkapi semua kolom.';
  }
}
---

<Layout title="Cek Status Pendaftaran">
  <section class="cek-status-section">
    <div class="container max-width-sm">
      <div class="form-card glass">
        <h1 class="page-title text-center">Cek Status Pendaftaran</h1>
        <p class="page-desc text-center mb-4">
          Masukkan Email dan Nama Lengkap yang Anda gunakan saat mendaftar untuk mengecek status atau melanjutkan proses pendaftaran Anda.
        </p>

        {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}

        <form method="POST" class="status-form">
          <div class="form-group">
            <label for="email">Email Pemesan</label>
            <input type="email" id="email" name="email" class="form-control" value={email} required placeholder="Contoh: budi@email.com" />
          </div>
          <div class="form-group mt-3">
            <label for="phone">Nomor WhatsApp Pemesan</label>
            <input type="text" id="phone" name="phone" class="form-control" value={phone} required placeholder="Contoh: 081234567890" />
          </div>
          <div class="form-group mt-3">
            <label for="name">Nama Lengkap Peserta</label>
            <input type="text" id="name" name="name" class="form-control" value={name} required placeholder="Sesuai pendaftaran" />
          </div>
          <div class="form-group mt-3">
            <label for="nomorId">Nomor Identitas (KTP/SIM) Peserta</label>
            <input type="text" id="nomorId" name="nomorId" class="form-control" value={nomorId} required placeholder="Sesuai pendaftaran" />
          </div>
          <div class="form-group mt-3">
            <label for="amount">Total Bayar (Termasuk Kode Unik)</label>
            <input type="number" id="amount" name="amount" class="form-control" value={amount} required placeholder="Contoh: 81001" />
          </div>
          <button type="submit" class="btn btn-primary btn-full mt-4">
            Cek & Upload Bukti
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cek-status-section {
    padding: 6rem 0;
    min-height: calc(100vh - 140px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .max-width-sm {
    max-width: 500px;
    width: 100%;
    margin: 0 auto;
  }
  .form-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
  }
  .page-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .alert {
    padding: 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }
  .alert-danger {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }
  .status-form {
    display: flex;
    flex-direction: column;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    color: white;
    font-family: inherit;
    transition: all 0.3s ease;
  }
  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(0, 229, 255, 0.2);
  }
  .btn-full {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
  }
</style>
