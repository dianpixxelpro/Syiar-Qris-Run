---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getAllEvents, getAllRegistrations } from "../../../lib/db";

// Fetch data awal untuk statistik
const events = await getAllEvents();
const registrations = await getAllRegistrations();

// Hitung Statistik
const totalEvents = events.length;
const upcomingEventsCount = events.filter(
  (e) => e.status === "UPCOMING",
).length;
const totalRegistered = registrations.filter(r => r.status === "PAID").length;
const totalRevenue = registrations
  .filter((r) => r.status === "PAID")
  .reduce((sum, r) => sum + r.amount, 0);

const formatPrice = (price: number) => {
  if (price === 0) return "Gratis";
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    minimumFractionDigits: 0,
  }).format(price);
};
---

<AdminLayout title="Dashboard Admin">
  <section class="admin-dashboard">
    
    <div class="container relative z-1">
      <div class="admin-header">
        <div>
          <h1 class="admin-title">Dashboard Admin</h1>
          <p class="admin-subtitle">
            Ikhtisar data sistem pendaftaran event Syiar QRIS Run
          </p>
        </div>
      </div>

      <!-- Kartu Statistik -->
      <div class="stats-grid">
        <div class="stat-box glass">
          <div class="stat-icon">total</div>
          <div class="stat-info">
            <span class="label">Total Event</span>
            <span class="value">{totalEvents}</span>
          </div>
        </div>
        <div class="stat-box glass">
          <div class="stat-icon upcoming">up</div>
          <div class="stat-info">
            <span class="label">Event Mendatang</span>
            <span class="value">{upcomingEventsCount}</span>
          </div>
        </div>
        <div class="stat-box glass">
          <div class="stat-icon registrants">users</div>
          <div class="stat-info">
            <span class="label">Total Pendaftar</span>
            <span class="value">{totalRegistered}</span>
          </div>
        </div>
        <div class="stat-box glass">
          <div class="stat-icon revenue">rp</div>
          <div class="stat-info">
            <span class="label">Total Pendapatan</span>
            <span class="value">{formatPrice(totalRevenue)}</span>
          </div>
        </div>
      </div>

      <div class="dashboard-welcome glass">
        <h2>Selamat Datang di Admin Panel</h2>
        <p>
          Gunakan menu navigasi di sebelah kiri untuk mengelola <strong
            >Event</strong
          >, memeriksa <strong>Pendaftar Masuk</strong>, atau melakukan <strong
            >Check-In Tiket</strong
          > saat hari H pelaksanaan event.
        </p>
      </div>
    </div>
  </section>
</AdminLayout>

<style>
  .admin-dashboard {
    padding: 3rem 0;
    position: relative;
    overflow-x: clip;
    min-height: calc(100vh - 72px - 300px);
  }

  .admin-glow {
    top: 5%;
    left: 5%;
    width: 450px;
    height: 450px;
    background-color: var(--accent-glow);
  }

  .admin-header {
    margin-bottom: 2.5rem;
  }

  .admin-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #fff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .admin-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .stat-box {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    background: rgba(45, 130, 255, 0.15);
    color: var(--primary);
  }

  .stat-icon.upcoming {
    background: rgba(112, 0, 255, 0.15);
    color: var(--accent-secondary);
  }

  .stat-icon.registrants {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
  }

  .stat-icon.revenue {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
  }

  .stat-info {
    display: flex;
    flex-direction: column;
  }

  .stat-info .label {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .stat-info .value {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-display);
    color: var(--text-primary);
  }

  .dashboard-welcome {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: #1e293b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .dashboard-welcome h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .dashboard-welcome p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
