---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Scanner & Check-In Tiket">
  <!-- Load library HTML5-QRCode via CDN -->
  <script src="https://unpkg.com/html5-qrcode" defer></script>

  <section class="checkin-section">
    <div class="container relative z-1 max-width-md">
      
      <div class="checkin-header">
        <h1 class="checkin-title">Check-In & Verifikasi Tiket</h1>
        <p class="checkin-subtitle">
          Masukkan ID Registrasi (contoh: <code>#REG-123</code>) untuk melihat data & NIK pendaftar. Lalu scan QR E-Tiket untuk konfirmasi check-in.
        </p>
      </div>

      <!-- STEP 1: INITIAL LOOKUP VIEW -->
      <div id="lookup-section" class="lookup-card glass">
        <h2 class="section-title">🔍 Cek Data Pendaftar</h2>
        <p class="section-desc">Masukkan ID registrasi `#REG` di bawah ini untuk mengecek data peserta dan NIK terlebih dahulu.</p>

        <form id="lookup-form" class="lookup-form">
          <div class="input-group">
            <span class="input-prefix">#REG-</span>
            <input 
              type="text" 
              id="lookup-input" 
              placeholder="Contoh: 123"
              autocomplete="off"
              required 
            />
            <button type="submit" id="lookup-btn" class="btn btn-primary">
              <span class="btn-text">Cek Data Peserta</span>
              <span class="btn-spinner hidden">⌛ Loading...</span>
            </button>
          </div>
        </form>

        <div class="camera-toggle-wrapper">
          <button id="start-lookup-scan-btn" class="btn btn-outline btn-full">
            📷 Atau Scan QR Code untuk Cari Data #REG
          </button>
          <button id="stop-lookup-scan-btn" class="btn btn-danger btn-full hidden">
            ❌ Matikan Kamera Lookup
          </button>
        </div>

        <!-- Camera Viewport Lookup -->
        <div id="camera-lookup-viewport-container" class="camera-viewport-wrapper hidden">
          <div id="reader-lookup"></div>
        </div>

        <!-- Alert Error Peringatan Input -->
        <div id="lookup-error-alert" class="alert-box alert-error hidden">
          <span class="alert-icon">⚠️</span>
          <span id="lookup-error-msg">Data registrasi tidak ditemukan.</span>
        </div>
      </div>

      <!-- STEP 2: VERIFIED DATA CARD VIEW -->
      <div id="data-result-section" class="data-result-card glass hidden">
        
        <div class="result-header">
          <div class="reg-id-badge">
            <span class="label">ID REGISTRASI</span>
            <h2 id="result-reg-id">#REG-0</h2>
          </div>
          <div class="status-badges">
            <span id="badge-payment" class="badge">LUNAS</span>
            <span id="badge-checkin" class="badge">BELUM CHECK-IN</span>
          </div>
        </div>

        <div class="result-grid">
          <!-- Main Participant Details (Nama + NIK) -->
          <div class="details-column">
            <div class="info-card">
              <h3>👤 Rincian Peserta & Nomor ID / NIK</h3>
              <div id="participants-list" class="participants-list">
                <!-- Will be dynamically populated with NIK, Name, Jersey -->
              </div>
            </div>

            <div class="info-card">
              <h3>📱 Detail Kontak</h3>
              <div class="info-row">
                <span class="info-label">WhatsApp:</span>
                <span id="result-phone" class="info-val">-</span>
              </div>
              <div class="info-row">
                <span class="info-label">Email:</span>
                <span id="result-email" class="info-val">-</span>
              </div>
              <div class="info-row">
                <span class="info-label">Event:</span>
                <span id="result-event" class="info-val">-</span>
              </div>
            </div>
          </div>

          <!-- Action Column: Camera QR Confirmation Only -->
          <div class="action-column">
            
            <!-- Box jika SIAP CHECK-IN via Kamera Scan -->
            <div id="checkin-ready-box" class="action-box box-ready hidden">
              <div class="action-header">
                <span class="icon">📷</span>
                <h4>Scan QR Code untuk Konfirmasi Check-In</h4>
              </div>
              <p>Data peserta dan NIK telah sesuai. Silakan aktifkan kamera dan scan QR Code pada E-Tiket peserta untuk menyelesaikan Check-In.</p>

              <div class="confirm-camera-wrapper">
                <button id="start-confirm-scan-btn" class="btn btn-success btn-full btn-lg">
                  📷 Buka Kamera & Scan QR Tiket
                </button>
                <button id="stop-confirm-scan-btn" class="btn btn-danger btn-full hidden">
                  ❌ Matikan Kamera Scan
                </button>
              </div>

              <!-- Camera Viewport Confirm -->
              <div id="camera-confirm-viewport-container" class="camera-viewport-wrapper hidden mt-3">
                <div id="reader-confirm"></div>
              </div>

              <!-- Divider -->
              <div style="display:flex; align-items:center; gap:0.75rem; margin:1rem 0;">
                <div style="flex:1; height:1px; background:rgba(255,255,255,0.15);"></div>
                <span style="font-size:0.75rem; color:#94a3b8; font-weight:600; letter-spacing:0.05em;">ATAU</span>
                <div style="flex:1; height:1px; background:rgba(255,255,255,0.15);"></div>
              </div>

              <!-- Manual Approve Button -->
              <button id="manual-approve-btn" class="btn btn-approve btn-full btn-lg">
                <span class="btn-text">✅ Approve Check-In Manual</span>
                <span class="btn-spinner hidden">⌛ Memproses...</span>
              </button>
              <p style="font-size:0.75rem; color:#94a3b8; margin-top:0.5rem; text-align:center;">
                Gunakan jika peserta tidak memiliki QR Code / E-Tiket
              </p>
            </div>

            <!-- Box jika SUDAH CHECK-IN -->
            <div id="checkin-already-box" class="action-box box-warning hidden">
              <div class="action-header">
                <span class="icon">⚠️</span>
                <h4>Sudah Check-In Sebelumnya</h4>
              </div>
              <p>Peserta ini <strong>SUDAH</strong> pernah melakukan check-in dan mengambil Race Pack.</p>
            </div>

            <!-- Box jika BELUM LUNAS / PENDING -->
            <div id="checkin-unpaid-box" class="action-box box-danger hidden">
              <div class="action-header">
                <span class="icon">❌</span>
                <h4>Pembayaran Belum Lunas</h4>
              </div>
              <p>Tiket ini statusnya masih <strong>PENDING / UNPAID</strong>. Silakan minta peserta melunasi pembayaran terlebih dahulu sebelum check-in.</p>
            </div>

            <!-- Notification Feedback Status Check-In -->
            <div id="action-feedback-alert" class="alert-box hidden">
              <span id="action-feedback-icon" class="alert-icon"></span>
              <span id="action-feedback-msg"></span>
            </div>

            <!-- Tombol Kembali / Reset -->
            <button id="reset-lookup-btn" class="btn btn-outline btn-full">
              🔄 Cek #REG Lain / Kembali
            </button>
          </div>
        </div>

      </div>

    </div>
  </section>
</AdminLayout>

<script>
  let html5QrCodeLookup: any = null;
  let html5QrCodeConfirm: any = null;
  let currentLoadedRegId: number | null = null;

  window.addEventListener('DOMContentLoaded', () => {
    const lookupForm = document.getElementById('lookup-form') as HTMLFormElement;
    const lookupInput = document.getElementById('lookup-input') as HTMLInputElement;
    const lookupBtn = document.getElementById('lookup-btn') as HTMLButtonElement;
    const lookupSection = document.getElementById('lookup-section')!;
    const lookupErrorAlert = document.getElementById('lookup-error-alert')!;
    const lookupErrorMsg = document.getElementById('lookup-error-msg')!;

    const dataResultSection = document.getElementById('data-result-section')!;
    const resultRegId = document.getElementById('result-reg-id')!;
    const badgePayment = document.getElementById('badge-payment')!;
    const badgeCheckin = document.getElementById('badge-checkin')!;
    const participantsList = document.getElementById('participants-list')!;
    const resultPhone = document.getElementById('result-phone')!;
    const resultEmail = document.getElementById('result-email')!;
    const resultEvent = document.getElementById('result-event')!;

    const checkinReadyBox = document.getElementById('checkin-ready-box')!;
    const checkinAlreadyBox = document.getElementById('checkin-already-box')!;
    const checkinUnpaidBox = document.getElementById('checkin-unpaid-box')!;
    
    const actionFeedbackAlert = document.getElementById('action-feedback-alert')!;
    const actionFeedbackIcon = document.getElementById('action-feedback-icon')!;
    const actionFeedbackMsg = document.getElementById('action-feedback-msg')!;

    const resetLookupBtn = document.getElementById('reset-lookup-btn')!;
    
    // Scanner Lookup Elements
    const startLookupScanBtn = document.getElementById('start-lookup-scan-btn')!;
    const stopLookupScanBtn = document.getElementById('stop-lookup-scan-btn')!;
    const cameraLookupViewportContainer = document.getElementById('camera-lookup-viewport-container')!;

    // Scanner Confirm Elements
    const startConfirmScanBtn = document.getElementById('start-confirm-scan-btn')!;
    const stopConfirmScanBtn = document.getElementById('stop-confirm-scan-btn')!;
    const cameraConfirmViewportContainer = document.getElementById('camera-confirm-viewport-container')!;

    // Manual Approve Button
    const manualApproveBtn = document.getElementById('manual-approve-btn') as HTMLButtonElement;

    // --- FUNCTION: Lookup Registration Data ---
    async function fetchRegistrationData(query: string) {
      showLookupError('');
      setLoading(lookupBtn, true);

      try {
        const res = await fetch(`/mlebuodewe/admin/api/checkin?query=${encodeURIComponent(query)}`);
        const json = await res.json();

        if (!json.success || !json.data) {
          showLookupError(json.message || 'Data registrasi tidak ditemukan.');
          return;
        }

        renderParticipantData(json.data);
      } catch (err) {
        console.error('Error fetching checkin data:', err);
        showLookupError('Terjadi kesalahan jaringan/server saat mengecek data.');
      } finally {
        setLoading(lookupBtn, false);
      }
    }

    // --- FUNCTION: Execute Check-In ---
    async function executeCheckIn(regId: number) {
      setActionFeedback('', '');

      try {
        const res = await fetch('/mlebuodewe/admin/api/checkin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: regId })
        });
        const json = await res.json();

        if (json.success) {
          setActionFeedback('success', '✓ Check-In Berhasil! ' + (json.message || 'Data telah diperbarui.'));
          // Update UI badge & action boxes
          badgeCheckin.className = 'badge badge-success';
          badgeCheckin.textContent = 'SUDAH CHECK-IN';
          
          checkinReadyBox.classList.add('hidden');
          checkinAlreadyBox.classList.remove('hidden');
        } else {
          setActionFeedback('error', '✗ ' + (json.message || 'Gagal memproses check-in.'));
        }
      } catch (err) {
        console.error('Error executing checkin:', err);
        setActionFeedback('error', '✗ Terjadi kesalahan sistem saat memproses check-in.');
      }
    }

    // --- RENDER DATA TO UI (TERMASUK NIK) ---
    function renderParticipantData(data: any) {
      currentLoadedRegId = data.id;
      
      // Stop any active scanners
      stopLookupScanner();
      stopConfirmScanner();

      resultRegId.textContent = `#REG-${data.id}`;
      resultPhone.textContent = data.phone || '-';
      resultEmail.textContent = data.email || '-';
      resultEvent.textContent = data.eventTitle || 'Syiar QRIS Run';

      // Render participants list with NIK
      participantsList.innerHTML = '';
      if (Array.isArray(data.participants) && data.participants.length > 0) {
        data.participants.forEach((p: any, idx: number) => {
          const item = document.createElement('div');
          item.className = 'participant-item';
          
          const nikVal = p.nomorId || p.nik || p.idCard || '-';
          const jenisIdVal = p.jenisId || 'NIK/ID';

          item.innerHTML = `
            <div class="p-number">${idx + 1}</div>
            <div class="p-details">
              <strong class="p-name">${p.name || 'Peserta'}</strong>
              <div class="p-nik-box">
                💳 <span class="nik-label">${jenisIdVal}:</span> <strong class="nik-value">${nikVal}</strong>
              </div>
              <div class="p-meta">
                ${p.ukuranJersey ? `<span class="badge-sub">Jersey: <strong>${p.ukuranJersey}</strong></span>` : ''}
                ${p.jenisKelamin ? `<span class="badge-sub">Gender: <strong>${p.jenisKelamin}</strong></span>` : ''}
                ${p.kategori ? `<span class="badge-sub">Kategori: <strong>${p.kategori}</strong></span>` : ''}
              </div>
            </div>
          `;
          participantsList.appendChild(item);
        });
      } else {
        participantsList.innerHTML = `
          <div class="participant-item">
            <div class="p-details">
              <strong class="p-name">${data.name}</strong>
            </div>
          </div>
        `;
      }

      // Status Payment
      if (data.status === 'PAID') {
        badgePayment.className = 'badge badge-success';
        badgePayment.textContent = 'LUNAS';
      } else if (data.status === 'EXPIRED') {
        badgePayment.className = 'badge badge-danger';
        badgePayment.textContent = 'EXPIRED';
      } else {
        badgePayment.className = 'badge badge-warning';
        badgePayment.textContent = 'PENDING';
      }

      // Status Checkin & Action Boxes
      checkinReadyBox.classList.add('hidden');
      checkinAlreadyBox.classList.add('hidden');
      checkinUnpaidBox.classList.add('hidden');
      setActionFeedback('', '');

      if (data.checkedIn) {
        badgeCheckin.className = 'badge badge-success';
        badgeCheckin.textContent = 'SUDAH CHECK-IN';
        checkinAlreadyBox.classList.remove('hidden');
      } else {
        badgeCheckin.className = 'badge badge-warning';
        badgeCheckin.textContent = 'BELUM CHECK-IN';

        if (data.status === 'PAID') {
          checkinReadyBox.classList.remove('hidden');
        } else {
          checkinUnpaidBox.classList.remove('hidden');
        }
      }

      // Switch view
      lookupSection.classList.add('hidden');
      dataResultSection.classList.remove('hidden');
    }

    // --- UI HELPER FUNCTIONS ---
    function showLookupError(msg: string) {
      if (msg) {
        lookupErrorMsg.textContent = msg;
        lookupErrorAlert.classList.remove('hidden');
      } else {
        lookupErrorAlert.classList.add('hidden');
      }
    }

    function setActionFeedback(type: 'success' | 'error' | '', msg: string) {
      if (!type) {
        actionFeedbackAlert.className = 'alert-box hidden';
        return;
      }
      actionFeedbackAlert.className = `alert-box alert-${type}`;
      actionFeedbackIcon.textContent = type === 'success' ? '✓' : '✗';
      actionFeedbackMsg.textContent = msg;
    }

    function setLoading(btn: HTMLButtonElement, loading: boolean) {
      const textSpan = btn.querySelector('.btn-text');
      const spinnerSpan = btn.querySelector('.btn-spinner');
      if (loading) {
        btn.disabled = true;
        if (textSpan) textSpan.classList.add('hidden');
        if (spinnerSpan) spinnerSpan.classList.remove('hidden');
      } else {
        btn.disabled = false;
        if (textSpan) textSpan.classList.remove('hidden');
        if (spinnerSpan) spinnerSpan.classList.add('hidden');
      }
    }

    function resetToLookupView() {
      stopLookupScanner();
      stopConfirmScanner();
      currentLoadedRegId = null;
      lookupInput.value = '';
      showLookupError('');
      dataResultSection.classList.add('hidden');
      lookupSection.classList.remove('hidden');
      lookupInput.focus();
    }

    // --- EVENT LISTENERS ---
    lookupForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = lookupInput.value.trim();
      if (val) {
        fetchRegistrationData(val);
      }
    });

    resetLookupBtn.addEventListener('click', () => {
      resetToLookupView();
    });

    // --- MANUAL APPROVE (tanpa scan QR) ---
    manualApproveBtn.addEventListener('click', async () => {
      if (!currentLoadedRegId) return;

      const confirmed = window.confirm(
        `Approve Check-In Manual untuk #REG-${currentLoadedRegId}?\n\nPastikan identitas peserta sudah diverifikasi secara manual.`
      );
      if (!confirmed) return;

      setLoading(manualApproveBtn, true);
      await executeCheckIn(currentLoadedRegId);
      setLoading(manualApproveBtn, false);

      // Sembunyikan tombol approve setelah berhasil
      if (badgeCheckin.textContent === 'SUDAH CHECK-IN') {
        manualApproveBtn.classList.add('hidden');
      }
    });

    // --- LOOKUP SCANNER LOGIC ---
    function startLookupScanner() {
      // @ts-ignore
      if (typeof Html5Qrcode === 'undefined') {
        alert('Library QR scanner sedang dimuat, mohon tunggu beberapa detik.');
        return;
      }

      startLookupScanBtn.classList.add('hidden');
      stopLookupScanBtn.classList.remove('hidden');
      cameraLookupViewportContainer.classList.remove('hidden');

      // @ts-ignore
      html5QrCodeLookup = new Html5Qrcode("reader-lookup");
      const config = { fps: 10, qrbox: { width: 220, height: 220 }, aspectRatio: 1.777778 };

      html5QrCodeLookup.start(
        { facingMode: "environment" },
        config,
        (decodedText: string) => {
          lookupInput.value = decodedText;
          fetchRegistrationData(decodedText);
          stopLookupScanner();
        },
        () => { /* Verbose logs ignored */ }
      ).catch((err: any) => {
        console.error('Kamera lookup gagal:', err);
        alert('Gagal mengakses kamera. Berikan izin akses kamera.');
        stopLookupScanner();
      });
    }

    function stopLookupScanner() {
      if (html5QrCodeLookup) {
        html5QrCodeLookup.stop().then(() => {
          html5QrCodeLookup = null;
        }).catch(() => {
          html5QrCodeLookup = null;
        });
      }
      startLookupScanBtn.classList.remove('hidden');
      stopLookupScanBtn.classList.add('hidden');
      cameraLookupViewportContainer.classList.add('hidden');
    }

    startLookupScanBtn.addEventListener('click', startLookupScanner);
    stopLookupScanBtn.addEventListener('click', stopLookupScanner);

    // --- CONFIRM SCANNER LOGIC (Kamera Scan untuk Check-In setelah Data Cocok) ---
    function startConfirmScanner() {
      // @ts-ignore
      if (typeof Html5Qrcode === 'undefined') {
        alert('Library QR scanner sedang dimuat, mohon tunggu beberapa detik.');
        return;
      }

      startConfirmScanBtn.classList.add('hidden');
      stopConfirmScanBtn.classList.remove('hidden');
      cameraConfirmViewportContainer.classList.remove('hidden');

      // @ts-ignore
      html5QrCodeConfirm = new Html5Qrcode("reader-confirm");
      const config = { fps: 10, qrbox: { width: 220, height: 220 }, aspectRatio: 1.777778 };

      html5QrCodeConfirm.start(
        { facingMode: "environment" },
        config,
        (decodedText: string) => {
          // Parse scanned QR code ID
          let scannedId: number | null = null;
          if (decodedText.startsWith('TICKET:QRISRUN-REG-')) {
            const parts = decodedText.split(':');
            if (parts.length > 1) {
              scannedId = parseInt(parts[1].replace('QRISRUN-REG-', ''), 10);
            }
          } else {
            const match = decodedText.match(/\d+/);
            if (match) scannedId = parseInt(match[0], 10);
          }

          if (scannedId && currentLoadedRegId && scannedId === currentLoadedRegId) {
            // QR Code ID Matches! Execute Check-In!
            executeCheckIn(currentLoadedRegId);
            stopConfirmScanner();
          } else if (scannedId) {
            setActionFeedback('error', `❌ QR Code yang di-scan (#REG-${scannedId}) TIDAK COCOK dengan data yang sedang dibuka (#REG-${currentLoadedRegId})!`);
          } else {
            setActionFeedback('error', '❌ QR Code tidak valid.');
          }
        },
        () => { /* Verbose logs ignored */ }
      ).catch((err: any) => {
        console.error('Kamera confirm gagal:', err);
        alert('Gagal mengakses kamera. Berikan izin akses kamera.');
        stopConfirmScanner();
      });
    }

    function stopConfirmScanner() {
      if (html5QrCodeConfirm) {
        html5QrCodeConfirm.stop().then(() => {
          html5QrCodeConfirm = null;
        }).catch(() => {
          html5QrCodeConfirm = null;
        });
      }
      startConfirmScanBtn.classList.remove('hidden');
      stopConfirmScanBtn.classList.add('hidden');
      cameraConfirmViewportContainer.classList.add('hidden');
    }

    startConfirmScanBtn.addEventListener('click', startConfirmScanner);
    stopConfirmScanBtn.addEventListener('click', stopConfirmScanner);
  });
</script>

<style>
  .checkin-section {
    padding: 2.5rem 0;
    min-height: calc(100vh - 120px);
  }

  .max-width-md {
    max-width: 860px;
  }

  .checkin-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .checkin-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .checkin-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .checkin-subtitle code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: var(--accent);
    font-weight: 600;
  }

  /* GLASS CARD STYLES */
  .lookup-card, .data-result-card {
    background: var(--bg-card, rgba(30, 41, 59, 0.7));
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    border-radius: var(--radius-lg, 16px);
    padding: 2.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  /* LOOKUP FORM */
  .lookup-form {
    margin-bottom: 1.5rem;
  }

  .input-group {
    display: flex;
    align-items: center;
    background-color: var(--bg-primary, #0f172a);
    border: 2px solid var(--border-color, rgba(255, 255, 255, 0.15));
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .input-group:focus-within {
    border-color: var(--accent, #3b82f6);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
  }

  .input-prefix {
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    color: var(--accent, #3b82f6);
    font-weight: 800;
    font-size: 1.1rem;
    border-right: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
  }

  .input-group input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.9rem 1rem;
    color: #fff;
    font-size: 1.1rem;
    outline: none;
  }

  .input-group .btn {
    border-radius: 0;
    padding: 0.9rem 1.75rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .camera-toggle-wrapper {
    margin-top: 1rem;
  }

  .camera-viewport-wrapper {
    margin-top: 1.5rem;
    background-color: #000;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    border: 2px solid var(--accent, #3b82f6);
    max-height: 300px;
  }

  #reader-lookup, #reader-confirm {
    width: 100%;
  }

  #reader-lookup video, #reader-confirm video {
    object-fit: cover !important;
  }

  /* ALERT BOX */
  .alert-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md, 10px);
    margin-top: 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .alert-error, .alert-box.alert-error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
