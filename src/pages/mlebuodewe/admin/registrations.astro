---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  getAllRegistrations,
  updateRegistrationStatus,
  getRegistrationWithEventById,
  getAllEvents,
} from "../../../lib/db";
import { sendTicketConfirmedEmail } from "../../../lib/email";
import { processBankMutationsCSV } from "../../../lib/ocr";
import { Buffer } from "node:buffer";

let errorMsg = "";
let successMsg =
  Astro.url.searchParams.get("msg") === "manual_success"
    ? "Pendaftar manual berhasil ditambahkan dan E-Tiket telah dikirim!"
    : "";

// Handle POST request (Konfirmasi Pembayaran / Import CSV)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action");
    const idStr = formData.get("id");

    if (action === "delete_reg" && idStr) {
      const id = parseInt(idStr.toString(), 10);
      const { deleteRegistration } = await import("../../../lib/db");
      const success = await deleteRegistration(id);
      if (success) {
        successMsg =
          "Pendaftaran berhasil dihapus. Slot tiket kembali tersedia!";
      } else {
        errorMsg = "Gagal menghapus pendaftaran.";
      }
    } else if (action === "add_manual") {
      const eventId = parseInt(formData.get("eventId")?.toString() || "0", 10);
      const email = formData.get("email")?.toString() || "";
      const phone = formData.get("phone")?.toString() || "";
      const amount = parseInt(formData.get("amount")?.toString() || "0", 10);
      const paymentMethod =
        formData.get("paymentMethod")?.toString() || "Manual (Admin)";

      const receiptFile = formData.get("receipt") as File;

      const participants = [];
      let i = 1;
      while (formData.has(`name_${i}`)) {
        participants.push({
          name: formData.get(`name_${i}`)?.toString() || "",
          jenisKelamin: formData.get(`jenisKelamin_${i}`)?.toString() || "",
          jenisId: formData.get(`jenisId_${i}`)?.toString() || "",
          nomorId: formData.get(`nomorId_${i}`)?.toString() || "",
          ukuranJersey: formData.get(`ukuranJersey_${i}`)?.toString() || "",
        });
        i++;
      }

      if (
        eventId &&
        participants.length > 0 &&
        email &&
        phone &&
        receiptFile &&
        receiptFile.size > 0
      ) {
        const nameField = JSON.stringify(participants);
        const { createRegistration, uploadPaymentProof } =
          await import("../../../lib/db");

        const newRegId = await createRegistration({
          eventId,
          name: nameField,
          email,
          phone,
          status: "PAID", // Langsung dianggap lunas
          amount,
          paymentMethod,
          checkedIn: false,
        });

        if (newRegId) {
          successMsg = `Pendaftar manual berhasil ditambahkan (${participants.length} tiket) dengan status LUNAS!`;

          // Kirim email e-tiket
          const regDetail = await getRegistrationWithEventById(newRegId);
          if (regDetail) {
            await sendTicketConfirmedEmail({
              to: regDetail.email,
              name: regDetail.name,
              eventTitle: regDetail.eventTitle,
              eventDate: regDetail.eventDate,
              eventLocation: regDetail.eventLocation,
              amount: regDetail.amount,
              regId: regDetail.id,
            });
          }

          if (receiptFile && receiptFile.size > 0) {
            if (receiptFile.size > 2 * 1024 * 1024) {
              errorMsg =
                "Pendaftar berhasil ditambahkan, namun Bukti Transfer gagal diunggah (Ukuran terlalu besar, Maks 2MB).";
            } else {
              const buffer = Buffer.from(await receiptFile.arrayBuffer());
              const base64Image = `data:${receiptFile.type};base64,${buffer.toString("base64")}`;
              const uploadResult = await uploadPaymentProof(
                newRegId,
                base64Image,
                new Date().toISOString(),
              );
              if (!uploadResult.success) {
                errorMsg =
                  "Pendaftar ditambahkan, tetapi gagal mengunggah Bukti Transfer: " +
                  uploadResult.message;
              }
            }
          }
          if (!errorMsg) {
            return Astro.redirect(
              "/mlebuodewe/admin/registrations?msg=manual_success",
            );
          }
        } else {
          errorMsg = "Gagal menambahkan pendaftar ke database.";
        }
      } else {
        errorMsg =
          "Mohon lengkapi data pendaftar (Event, Nama, Email, No. WA, dan Bukti Transfer wajib diisi).";
      }
    } else if (action === "confirm" && idStr) {
      const id = parseInt(idStr.toString(), 10);
      const regDetail = await getRegistrationWithEventById(id);
      const success = await updateRegistrationStatus(id, "PAID");
      if (success) {
        successMsg = "Pembayaran berhasil dikonfirmasi secara manual!";
        if (regDetail) {
          await sendTicketConfirmedEmail({
            to: regDetail.email,
            name: regDetail.name,
            eventTitle: regDetail.eventTitle,
            eventDate: regDetail.eventDate,
            eventLocation: regDetail.eventLocation,
            amount: regDetail.amount,
            regId: regDetail.id,
          });
        }
      } else {
        errorMsg = "Gagal mengonfirmasi pembayaran.";
      }
    } else if (action === "edit_reg" && idStr) {
      const id = parseInt(idStr.toString(), 10);
      const email = formData.get("email")?.toString() || "";
      const phone = formData.get("phone")?.toString() || "";
      const status = formData.get("status")?.toString() || "";
      const receiptFile = formData.get("receipt") as File | null;
      
      const { updateRegistration, updateRegistrationStatus, uploadPaymentProof, getRegistrationWithEventById } = await import("../../../lib/db");
      
      let editSuccess = await updateRegistration(id, { email, phone });
      
      if (editSuccess) {
        const regDetail = await getRegistrationWithEventById(id);
        
        if (status && regDetail && regDetail.status !== status) {
           const updateStatusSuccess = await updateRegistrationStatus(id, status as any);
           if (updateStatusSuccess && status === "PAID") {
             const updatedReg = await getRegistrationWithEventById(id);
             if (updatedReg) {
               await sendTicketConfirmedEmail({
                 to: email || updatedReg.email,
                 name: updatedReg.name,
                 eventTitle: updatedReg.eventTitle,
                 eventDate: updatedReg.eventDate,
                 eventLocation: updatedReg.eventLocation,
                 amount: updatedReg.amount,
                 regId: updatedReg.id,
               });
             }
           }
        }
        
        if (receiptFile && receiptFile.size > 0) {
           if (receiptFile.size <= 2 * 1024 * 1024) {
             const buffer = Buffer.from(await receiptFile.arrayBuffer());
             const base64Image = `data:${receiptFile.type};base64,${buffer.toString("base64")}`;
             await uploadPaymentProof(id, base64Image, new Date().toISOString());
           } else {
             errorMsg = "Data diupdate, tapi Bukti Transfer gagal diunggah (Ukuran terlalu besar, Maks 2MB).";
           }
        }
        
        if (!errorMsg) {
           successMsg = "Data pendaftar berhasil diperbarui!";
        }
      } else {
        errorMsg = "Gagal memperbarui data pendaftar.";
      }
    } else if (action === "import_csv") {
      const file = formData.get("csv_file") as File;
      if (file && file.size > 0) {
        let text = "";
        let isImage = false;
        const fileName = file.name.toLowerCase();

        if (fileName.endsWith(".pdf")) {
          try {
            const buffer = Buffer.from(await file.arrayBuffer());
            const pdfParse = (await import("pdf-parse")).default;
            const pdfData = await pdfParse(buffer);
            text = pdfData.text;
          } catch (pdfErr: any) {
            errorMsg =
              "Gagal membaca PDF: " + (pdfErr.message || String(pdfErr));
            throw new Error("SILENT");
          }
        } else if (fileName.match(/\.(png|jpe?g)$/i)) {
          isImage = true;
          try {
            const buffer = Buffer.from(await file.arrayBuffer());
            const { createWorker } = await import("tesseract.js");
            const os = await import("os");
            const worker = await createWorker("eng", 1, {
              cachePath: os.tmpdir(),
            });
            const { data } = await worker.recognize(buffer);
            text = data.text;
            console.log("\n=== HASIL OCR FOTO MUTASI ===");
            console.log(text);
            console.log("=============================\n");
            await worker.terminate();
          } catch (imgErr: any) {
            errorMsg =
              "Gagal membaca Foto Mutasi: " +
              (imgErr.message || String(imgErr));
            throw new Error("SILENT");
          }
        } else if (fileName.match(/\.(xlsx|xls)$/i)) {
          try {
            const buffer = Buffer.from(await file.arrayBuffer());
            const xlsx = await import("xlsx");
            const workbook = xlsx.read(buffer, { type: "buffer" });
            for (const sheetName of workbook.SheetNames) {
              const sheet = workbook.Sheets[sheetName];
              const csvString = xlsx.utils.sheet_to_csv(sheet);
              text += csvString + "\n";
            }
          } catch (xlsErr: any) {
            errorMsg =
              "Gagal membaca File Excel: " + (xlsErr.message || String(xlsErr));
            throw new Error("SILENT");
          }
        } else {
          text = await file.text();
        }

        const pendingRegs = await getAllRegistrations();
        const pendingOnly = pendingRegs.filter((r) => r.status === "PENDING");

        const results = await processBankMutationsCSV(
          text,
          pendingOnly,
          isImage,
        );

        if (results.confirmedCount > 0) {
          successMsg = `Sistem berhasil memverifikasi ${results.confirmedCount} pembayaran secara otomatis dari mutasi!`;
          // Mengirim email untuk yang terkonfirmasi otomatis
          for (const confId of results.confirmedIds) {
            const regDetail = await getRegistrationWithEventById(confId);
            if (regDetail) {
              await sendTicketConfirmedEmail({
                to: regDetail.email,
                name: regDetail.name,
                eventTitle: regDetail.eventTitle,
                eventDate: regDetail.eventDate,
                eventLocation: regDetail.eventLocation,
                amount: regDetail.amount,
                regId: regDetail.id,
              });
            }
          }
        } else {
          errorMsg =
            "Sistem memproses CSV mutasi, namun tidak ada kecocokan nominal unik dengan tiket PENDING yang ditemukan.";
        }
      } else {
        errorMsg = "Mohon unggah file mutasi CSV yang valid.";
      }
    }
  } catch (err: any) {
    if (err.message !== "SILENT") {
      errorMsg =
        "Terjadi kesalahan saat memproses permintaan: " +
        (err.message || String(err));
      console.error(err);
    }
  }
}

// Re-fetch data
let registrationsDisplay = await getAllRegistrations();
const allEvents = await getAllEvents();

const formatPrice = (price: number) => {
  if (price === 0) return "Gratis";
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    minimumFractionDigits: 0,
  }).format(price);
};

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString("id-ID", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};

const parseName = (nameStr: string) => {
  try {
    const arr = JSON.parse(nameStr);
    if (Array.isArray(arr) && arr.length > 0) {
      if (arr.length === 1) return arr[0].name;
      const allNames = arr.map((p: any) => p.name).join(", ");
      return `${allNames} (Kolektif: ${arr.length} orang)`;
    }
  } catch (e) {}
  return nameStr;
};
---

<AdminLayout title="Data Pendaftar">
  <section class="admin-dashboard">
    <div class="glow-spot admin-glow"></div>
    <div class="container relative z-1 admin-container">
      <div class="admin-header">
        <div>
          <h1 class="admin-title">Pendaftar Masuk</h1>
          <p class="admin-subtitle">
            Kelola pembayaran, konfirmasi registrasi, dan cek tiket masuk.
          </p>
        </div>
      </div>

      {successMsg && <div class="alert alert-success">{successMsg}</div>}
      {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}

      <div class="table-container glass">
        <div
          class="table-header-flex"
          style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;"
        >
          <h2 class="table-title" style="margin: 0; min-width: 200px;">
            Data Pendaftar Masuk
          </h2>
          <div
            class="header-actions"
            style="display: flex; flex-wrap: wrap; gap: 0.8rem; align-items: center; justify-content: flex-end; flex: 1;"
          >
            <div
              class="filter-group"
              style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; background: rgba(255,255,255,0.03); padding: 0.4rem 0.8rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05);"
            >
              <label
                class="filter-label"
                style="font-size: 0.8rem; color: #94a3b8; margin:0;"
                >Filter Tgl:</label
              >
              <div
                class="date-inputs"
                style="display: flex; align-items: center; gap: 0.4rem;"
              >
                <input
                  type="date"
                  id="filter-date-start"
                  class="form-control date-input"
                  style="padding: 0.3rem; font-size: 0.8rem; height: auto;"
                />
                <span
                  class="date-separator"
                  style="color: #64748b; font-size: 0.8rem;">-</span
                >
                <input
                  type="date"
                  id="filter-date-end"
                  class="form-control date-input"
                  style="padding: 0.3rem; font-size: 0.8rem; height: auto;"
                />
              </div>

              <input
                type="text"
                id="filter-name"
                class="form-control"
                placeholder="Cari Nama..."
                style="padding: 0.3rem 0.6rem; font-size: 0.8rem; height: auto; border-radius: 6px; background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); color: white;"
              />
              
              <select
                id="filter-status"
                class="form-control"
                style="padding: 0.3rem 0.6rem; font-size: 0.8rem; height: auto; border-radius: 6px; background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); color: white;"
              >
                <option value="">Semua Status</option>
                <option value="PENDING">PENDING</option>
                <option value="PAID">PAID</option>
                <option value="EXPIRED">EXPIRED</option>
                <option value="CANCELLED">CANCELLED</option>
              </select>

              <button
                type="button"
                id="btn-reset-filter"
                class="btn btn-outline btn-sm reset-btn"
                style="padding: 0.3rem 0.6rem; font-size: 0.8rem; height: auto;"
                >Reset</button
              >
            </div>

            <button
              type="button"
              id="btn-export-csv"
              class="btn btn-outline btn-small export-btn"
              style="padding: 0.5rem 0.9rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem;"
            >
              <span>⬇️</span> Export Data
            </button>

            <button
              type="button"
              class="btn btn-primary btn-small"
              id="btn-add-manual"
              style="padding: 0.5rem 0.9rem; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.4);"
            >
              <span style="font-size: 1rem;">➕</span> Tambah Pendaftar
            </button>
          </div>
        </div>

        {
          registrationsDisplay.length > 0 ? (
            <div class="table-scroll">
              <table class="event-table">
                <thead>
                  <tr>
                    <th>Reg ID</th>
                    <th>Nama Pendaftar</th>
                    <th>Kontak</th>
                    <th>Event Terdaftar</th>
                    <th>Total Bayar</th>
                    <th>Bukti Transfer</th>
                    <th>Status</th>
                    <th>Check-In</th>
                    <th>Tanggal Daftar</th>
                    <th class="actions-col">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  {registrationsDisplay.map((reg) => (
                    <tr
                      data-id={reg.id}
                      data-raw-name={reg.name}
                      data-email={reg.email}
                      data-phone={reg.phone}
                      data-amount={reg.amount}
                      data-status={reg.status}
                      data-checkin={reg.checkedIn ? "SUDAH" : "BELUM"}
                      data-date={formatDate(reg.createdAt)}
                      data-has-proof={reg.paymentProof ? "Ada" : "Tidak"}
                    >
                      <td class="reg-id-cell">
                        <strong>#REG-{reg.id}</strong>
                      </td>
                      <td>
                        <div class="event-name-cell">
                          <strong>{parseName(reg.name)}</strong>
                          <span class="event-id">{reg.email}</span>
                        </div>
                      </td>
                      <td>{reg.phone}</td>
                      <td>
                        <div class="event-name-cell">
                          <strong>{reg.eventTitle}</strong>
                          <span class="event-id">Event ID: #{reg.eventId}</span>
                        </div>
                      </td>
                      <td>{formatPrice(reg.amount)}</td>
                      <td>
                        {reg.paymentProof ? (
                          <button
                            type="button"
                            class="btn-table btn-edit view-proof-btn"
                            data-proof={reg.paymentProof}
                            style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.5);"
                          >
                            Lihat Bukti
                          </button>
                        ) : (
                          <span style="color: var(--text-muted); font-size: 0.85rem;">
                            Belum Upload
                          </span>
                        )}
                      </td>
                      <td>
                        <span
                          class={`status-badge ${reg.status.toLowerCase()}`}
                        >
                          {reg.status}
                        </span>
                      </td>
                      <td>
                        <span
                          class={`status-badge ${reg.checkedIn ? "paid" : "pending"}`}
                        >
                          {reg.checkedIn ? "SUDAH" : "BELUM"}
                        </span>
                      </td>
                      <td class="date-cell">{formatDate(reg.createdAt)}</td>
                      <td>
                        <div class="action-buttons" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                          {reg.status === "PENDING" ? (
                            reg.paymentProof ? (
                                <form method="POST" style="margin: 0;">
                                  <input type="hidden" name="action" value="confirm" />
                                  <input type="hidden" name="id" value={reg.id} />
                                  <button type="submit" class="btn-table btn-confirm">Konfirmasi Bayar</button>
                                </form>
                            ) : (
                              <span style="font-size: 0.85rem; color: #94a3b8; font-style: italic; margin-right: 0.5rem;">
                                Menunggu Bukti
                              </span>
                            )
                          ) : reg.status === "EXPIRED" ? (
                            <>
                              <span style="font-size: 0.85rem; color: #ef4444; font-style: italic; margin-right: 0.5rem;">Kadaluarsa</span>
                              <button
                                type="button"
                                class="btn-table btn-edit open-edit-modal-btn"
                                data-id={reg.id}
                                data-email={reg.email}
                                data-phone={reg.phone}
                                data-status={reg.status}
                                style="background: rgba(45, 130, 255, 0.15); color: #3b82f6; border: 1px solid rgba(45, 130, 255, 0.4);"
                              >
                                ✏️ Edit
                              </button>
                            </>
                          ) : (
                            <a href={`/ticket/${reg.id}`} class="btn-table btn-edit" target="_blank">Lihat Tiket</a>
                          )}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            
            <div id="pagination-controls" style="display: flex; gap: 0.5rem; justify-content: center; margin-top: 1.5rem; flex-wrap: wrap;"></div>
          ) : (
            <div class="empty-table">
              <p>Belum ada data pendaftar masuk.</p>
            </div>
          )
        }
      </div>

      <!-- Modal Tambah Pendaftar Manual -->
      <div id="addManualModal" class="modal-overlay">
        <div
          class="modal-content glass"
          style="max-width: 900px; max-height: 90vh; overflow-y: auto; padding: 2rem;"
        >
          <div
            class="modal-header"
            style="position: sticky; top: -2rem; background: rgba(15, 23, 42, 0.98); z-index: 10; padding: 1.5rem 0 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 1.5rem; margin-top: -2rem;"
          >
            <h3 style="margin: 0; font-size: 1.5rem;">
              ➕ Tambah Pendaftar Manual
            </h3>
            <button
              class="close-modal"
              id="closeAddManualModal"
              style="position: absolute; right: 0; top: 1.5rem; background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;"
              >&times;</button
            >
          </div>
          <form
            method="POST"
            class="manual-add-form"
            enctype="multipart/form-data"
          >
            <input type="hidden" name="action" value="add_manual" />

            <div
              style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;"
            >
              <div class="form-group">
                <label
                  for="manualEventId"
                  style="display:block; margin-bottom:0.5rem;"
                  >Event <span class="text-danger">*</span></label
                >
                <select
                  name="eventId"
                  id="manualEventId"
                  class="form-control"
                  required
                  style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                >
                  <option value="">-- Pilih Event --</option>
                  {
                    allEvents.map((evt: any) => (
                      <option value={evt.id}>
                        {evt.title} ({evt.status})
                      </option>
                    ))
                  }
                </select>
              </div>

              <div class="form-group">
                <label
                  for="manualEmail"
                  style="display:block; margin-bottom:0.5rem;"
                  >Email Pemesan <span class="text-danger">*</span></label
                >
                <input
                  type="email"
                  name="email"
                  id="manualEmail"
                  class="form-control"
                  required
                  style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                />
              </div>
            </div>

            <div
              style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;"
            >
              <div class="form-group">
                <label
                  for="manualPhone"
                  style="display:block; margin-bottom:0.5rem;"
                  >No. WhatsApp <span class="text-danger">*</span></label
                >
                <input
                  type="text"
                  name="phone"
                  id="manualPhone"
                  class="form-control"
                  placeholder="Contoh: 08123456789"
                  required
                  style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                />
              </div>

              <div class="form-group">
                <label
                  for="manualReceipt"
                  style="display:block; margin-bottom:0.5rem;"
                  >Unggah Bukti Transfer <span class="text-danger">*</span
                  ></label
                >
                <input
                  type="file"
                  name="receipt"
                  id="manualReceipt"
                  accept="image/*"
                  class="form-control"
                  required
                  style="width:100%; padding:0.5rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                />
              </div>
            </div>

            <div
              style="background: rgba(255,255,255,0.03); padding: 1.5rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid rgba(255,255,255,0.1);"
            >
              <div
                style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1.5rem;"
              >
                <h4 style="margin:0; font-size: 1.1rem;">Data Diri Peserta</h4>
                <div>
                  <button
                    type="button"
                    id="admin-add-participant-btn"
                    class="btn btn-primary btn-sm"
                    style="padding: 0.4rem 0.8rem; font-size: 0.8rem;"
                    >+ Tambah</button
                  >
                  <button
                    type="button"
                    id="admin-remove-participant-btn"
                    class="btn btn-danger btn-sm"
                    style="padding: 0.4rem 0.8rem; font-size: 0.8rem; display: none;"
                    >- Kurangi</button
                  >
                </div>
              </div>

              <div id="admin-participants-container">
                <!-- Participant 1 -->
                <div
                  class="admin-participant-block"
                  data-index="1"
                  style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px dashed rgba(255,255,255,0.1);"
                >
                  <h5
                    style="margin-top:0; margin-bottom:1rem; color: var(--accent);"
                  >
                    Peserta 1
                  </h5>

                  <div
                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 1rem;"
                  >
                    <div class="form-group">
                      <label style="display:block; margin-bottom:0.5rem;"
                        >Nama Lengkap (Sesuai ID) *</label
                      >
                      <input
                        type="text"
                        name="name_1"
                        class="form-control"
                        required
                        style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                      />
                    </div>
                    <div class="form-group">
                      <label style="display:block; margin-bottom:0.5rem;"
                        >Nomor Identitas *</label
                      >
                      <input
                        type="text"
                        name="nomorId_1"
                        class="form-control"
                        required
                        style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                      />
                    </div>
                  </div>

                  <div
                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.5rem;"
                  >
                    <div class="form-group">
                      <label style="display:block; margin-bottom:0.5rem;"
                        >Jenis Kelamin *</label
                      >
                      <select
                        name="jenisKelamin_1"
                        class="form-control"
                        required
                        style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                      >
                        <option value="Pria">Pria</option>
                        <option value="Wanita">Wanita</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label style="display:block; margin-bottom:0.5rem;"
                        >Jenis ID *</label
                      >
                      <select
                        name="jenisId_1"
                        class="form-control"
                        required
                        style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                      >
                        <option value="KTP">KTP</option>
                        <option value="SIM">SIM</option>
                        <option value="KTM / Kartu Pelajar"
                          >KTM / Kartu Pelajar</option
                        >
                        <option value="Paspor">Paspor</option>
                        <option value="Lainnya">Lainnya</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label style="display:block; margin-bottom:0.5rem;"
                        >Ukuran Jersey *</label
                      >
                      <select
                        name="ukuranJersey_1"
                        class="form-control"
                        required
                        style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                      >
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="XXL">XXL</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div
              style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;"
            >
              <div class="form-group">
                <label
                  for="manualAmountDisplay"
                  style="display:block; margin-bottom:0.5rem;"
                  >Total Bayar Keseluruhan (Rp)</label
                >
                <input
                  type="text"
                  id="manualAmountDisplay"
                  class="form-control"
                  placeholder="Rp 0"
                  style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                />
                <input
                  type="hidden"
                  name="amount"
                  id="manualAmountValue"
                  value="0"
                />
              </div>

              <div class="form-group">
                <label
                  for="manualPaymentMethod"
                  style="display:block; margin-bottom:0.5rem;"
                  >Metode Pembayaran</label
                >
                <input
                  type="text"
                  name="paymentMethod"
                  id="manualPaymentMethod"
                  class="form-control"
                  value="Manual (Admin)"
                  style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;"
                />
              </div>
            </div>

            <div
              class="form-actions"
              style="display:flex; justify-content:flex-end; gap:1rem; position: sticky; bottom: -2rem; background: rgba(15, 23, 42, 0.98); padding: 1.5rem 0; border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: 1rem; z-index: 10;"
            >
              <button
                type="button"
                class="btn btn-outline"
                id="cancelAddManual"
                style="padding: 0.6rem 1.5rem;">Batal</button
              >
              <button
                type="submit"
                class="btn btn-primary"
                id="btn-submit-manual"
                style="padding: 0.6rem 1.5rem;">Simpan Pendaftar</button
              >
            </div>
          </form>
        </div>
      </div>

      <!-- Modal Pratinjau Bukti Pembayaran -->
      <div id="receipt-modal" class="modal-overlay glass">
        <div class="modal-content glass">
          <span class="close-btn" id="close-modal">&times;</span>
          <h3 class="modal-title">Bukti Transfer</h3>
          <div class="modal-body">
            <img id="modal-img" src="" alt="Bukti Transfer" />
          </div>
        </div>
      </div>

      <!-- Modal Edit Pendaftar -->
      <div id="editRegModal" class="modal-overlay">
        <div class="modal-content glass" style="max-width: 600px; padding: 2rem;">
          <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <h3 style="margin: 0; font-size: 1.5rem;">✏️ Edit Pendaftar</h3>
            <button class="close-modal" id="closeEditRegModal" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer;">&times;</button>
          </div>
          <form method="POST" enctype="multipart/form-data">
            <input type="hidden" name="action" value="edit_reg" />
            <input type="hidden" name="id" id="editRegId" />
            
            <div class="form-group mb-3" style="margin-bottom: 1.2rem;">
              <label style="display:block; margin-bottom:0.5rem;">Email Pemesan</label>
              <input type="email" name="email" id="editRegEmail" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;" />
            </div>
            
            <div class="form-group mb-3" style="margin-bottom: 1.2rem;">
              <label style="display:block; margin-bottom:0.5rem;">No. WhatsApp</label>
              <input type="text" name="phone" id="editRegPhone" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;" />
            </div>
            
            <div class="form-group mb-3" style="margin-bottom: 1.2rem;">
              <label style="display:block; margin-bottom:0.5rem;">Status Pendaftaran</label>
              <select name="status" id="editRegStatus" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;">
                <option value="PENDING">PENDING (Menunggu Pembayaran)</option>
                <option value="PAID">PAID (Lunas)</option>
                <option value="EXPIRED">EXPIRED (Kadaluarsa)</option>
              </select>
            </div>
            
            <div class="form-group mb-3" style="margin-bottom: 1.5rem;">
              <label style="display:block; margin-bottom:0.5rem;">Upload/Timpa Bukti Transfer (Opsional)</label>
              <input type="file" name="receipt" accept="image/*" class="form-control" style="width:100%; padding:0.5rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;" />
              <small style="color: #94a3b8; display: block; margin-top: 0.25rem;">Kosongkan jika tidak ingin mengubah bukti transfer.</small>
            </div>
            
            <div style="display:flex; justify-content:flex-end; gap:1rem; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 1.5rem;">
              <button type="button" class="btn btn-outline" id="cancelEditReg" style="padding: 0.6rem 1.5rem;">Batal</button>
              <button type="submit" class="btn btn-primary" style="padding: 0.6rem 1.5rem;">Simpan Perubahan</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  // Filter and Export Logic
  const tableRows = document.querySelectorAll(".event-table tbody tr");
  const filterDateStart = document.getElementById(
    "filter-date-start",
  ) as HTMLInputElement;
  const filterDateEnd = document.getElementById(
    "filter-date-end",
  ) as HTMLInputElement;
  const filterName = document.getElementById("filter-name") as HTMLInputElement;
  const filterStatus = document.getElementById("filter-status") as HTMLSelectElement;
  const resetFilterBtn = document.getElementById("btn-reset-filter");
  const paginationControls = document.getElementById("pagination-controls");

  let currentPage = 1;
  const rowsPerPage = 200;
  let matchedRows: HTMLElement[] = [];

  const renderPagination = () => {
    if (!paginationControls) return;
    paginationControls.innerHTML = "";
    const totalPages = Math.ceil(matchedRows.length / rowsPerPage);
    if (totalPages <= 1) return;

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement("button");
      btn.textContent = i.toString();
      btn.className = `btn btn-sm ${i === currentPage ? "btn-primary" : "btn-outline"}`;
      btn.style.padding = "0.3rem 0.7rem";
      btn.style.fontSize = "0.85rem";
      btn.addEventListener("click", () => {
        currentPage = i;
        renderPage();
        renderPagination();
      });
      paginationControls.appendChild(btn);
    }
  };

  const renderPage = () => {
    // Hide all first
    tableRows.forEach(row => ((row as HTMLElement).style.display = "none"));
    
    // Show only rows for current page
    const startIdx = (currentPage - 1) * rowsPerPage;
    const endIdx = startIdx + rowsPerPage;
    
    for (let i = startIdx; i < endIdx && i < matchedRows.length; i++) {
      matchedRows[i].style.display = "";
    }
  };

  const applyFilter = () => {
    const startStr = filterDateStart?.value;
    const endStr = filterDateEnd?.value;
    const nameStr = filterName?.value.toLowerCase() || "";
    const statusStr = filterStatus?.value || "";

    const startDate = startStr ? new Date(startStr).setHours(0, 0, 0, 0) : 0;
    const endDate = endStr
      ? new Date(endStr).setHours(23, 59, 59, 999)
      : Infinity;

    matchedRows = [];

    tableRows.forEach((row) => {
      const dateRaw = row.getAttribute("data-date");
      const nameRaw = row.getAttribute("data-raw-name")?.toLowerCase() || "";
      const statusRaw = row.getAttribute("data-status") || "";
      let isMatch = true;

      if (dateRaw) {
        const rowDate = new Date(dateRaw).getTime();
        if (rowDate < startDate || rowDate > endDate) {
          isMatch = false;
        }
      }

      if (nameStr && !nameRaw.includes(nameStr)) {
        isMatch = false;
      }

      if (statusStr && statusRaw !== statusStr) {
        isMatch = false;
      }

      if (isMatch) {
        matchedRows.push(row as HTMLElement);
      } else {
        (row as HTMLElement).style.display = "none";
      }
    });

    currentPage = 1;
    renderPage();
    renderPagination();
  };

  if (filterDateStart && filterDateEnd && filterName && filterStatus && resetFilterBtn) {
    filterDateStart.addEventListener("change", applyFilter);
    filterDateEnd.addEventListener("change", applyFilter);
    filterName.addEventListener("keyup", applyFilter);
    filterStatus.addEventListener("change", applyFilter);

    resetFilterBtn.addEventListener("click", () => {
      filterDateStart.value = "";
      filterDateEnd.value = "";
      filterName.value = "";
      filterStatus.value = "";
      applyFilter();
    });
  }

  // Initialize view
  applyFilter();

  // Edit Registration Modal Logic
  const editRegModal = document.getElementById("editRegModal");
  const closeEditRegModal = document.getElementById("closeEditRegModal");
  const cancelEditReg = document.getElementById("cancelEditReg");
  
  const editRegId = document.getElementById("editRegId") as HTMLInputElement;
  const editRegEmail = document.getElementById("editRegEmail") as HTMLInputElement;
  const editRegPhone = document.getElementById("editRegPhone") as HTMLInputElement;
  const editRegStatus = document.getElementById("editRegStatus") as HTMLSelectElement;

  document.querySelectorAll(".open-edit-modal-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      editRegId.value = target.getAttribute("data-id") || "";
      editRegEmail.value = target.getAttribute("data-email") || "";
      editRegPhone.value = target.getAttribute("data-phone") || "";
      
      const status = target.getAttribute("data-status") || "PENDING";
      for (let i = 0; i < editRegStatus.options.length; i++) {
        if (editRegStatus.options[i].value === status) {
          editRegStatus.selectedIndex = i;
          break;
        }
      }
      
      if (editRegModal) editRegModal.classList.add("active");
    });
  });

  const hideEditModal = () => {
    if (editRegModal) editRegModal.classList.remove("active");
  };

  if (closeEditRegModal) closeEditRegModal.addEventListener("click", hideEditModal);
  if (cancelEditReg) cancelEditReg.addEventListener("click", hideEditModal);

  const exportBtn = document.getElementById("btn-export-csv");
  if (exportBtn) {
    exportBtn.addEventListener("click", () => {
      const csvData = [];
      const headers = [
        "Reg ID",
        "Nama Peserta",
        "Email Pemesan",
        "No WA Pemesan",
        "Jenis Kelamin",
        "Jenis ID",
        "Nomor ID",
        "Ukuran Jersey",
        "Total Bayar (Satu Order)",
        "Status",
        "Check-In",
        "Tanggal Daftar",
        "Bukti Upload",
      ];
      csvData.push(headers.join(","));

      tableRows.forEach((row) => {
        if ((row as HTMLElement).style.display !== "none") {
          const id = row.querySelector(".reg-id-cell")?.textContent || "";
          const name = row.getAttribute("data-raw-name") || "";
          const email = row.getAttribute("data-email") || "";
          const phone = row.getAttribute("data-phone") || "";
          const amount = row.getAttribute("data-amount") || "";
          const status = row.getAttribute("data-status") || "";
          const checkin = row.getAttribute("data-checkin") || "";
          const date = row.getAttribute("data-date") || "";
          const proof = row.getAttribute("data-has-proof") || "Tidak";

          const escapeCsv = (str: string) =>
            `"${String(str || "-").replace(/"/g, '""')}"`;

          try {
            const arr = JSON.parse(name);
            if (Array.isArray(arr) && arr.length > 0) {
              arr.forEach((p: any) => {
                csvData.push(
                  [
                    escapeCsv(id),
                    escapeCsv(p.name),
                    escapeCsv(email),
                    escapeCsv(phone),
                    escapeCsv(p.jenisKelamin),
                    escapeCsv(p.jenisId),
                    escapeCsv(p.nomorId),
                    escapeCsv(p.ukuranJersey),
                    escapeCsv(amount),
                    escapeCsv(status),
                    escapeCsv(checkin),
                    escapeCsv(date),
                    escapeCsv(proof),
                  ].join(","),
                );
              });
            } else {
              csvData.push(
                [
                  escapeCsv(id),
                  escapeCsv(name),
                  escapeCsv(email),
                  escapeCsv(phone),
                  escapeCsv("-"),
                  escapeCsv("-"),
                  escapeCsv("-"),
                  escapeCsv("-"),
                  escapeCsv(amount),
                  escapeCsv(status),
                  escapeCsv(checkin),
                  escapeCsv(date),
                  escapeCsv(proof),
                ].join(","),
              );
            }
          } catch (e) {
            csvData.push(
              [
                escapeCsv(id),
                escapeCsv(name),
                escapeCsv(email),
                escapeCsv(phone),
                escapeCsv("-"),
                escapeCsv("-"),
                escapeCsv("-"),
                escapeCsv("-"),
                escapeCsv(amount),
                escapeCsv(status),
                escapeCsv(checkin),
                escapeCsv(date),
                escapeCsv(proof),
              ].join(","),
            );
          }
        }
      });

      const csvString = csvData.join("\n");
      const blob = new Blob([csvString], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);

      const now = new Date();
      const timestamp = now.toISOString().replace(/[:.]/g, "-");
      link.setAttribute("download", `data_pendaftar_${timestamp}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  // Tambah Manual Logic
  const addManualBtn = document.getElementById("btn-add-manual");
  const addManualModal = document.getElementById("addManualModal");
  const closeAddManualModal = document.getElementById("closeAddManualModal");
  const cancelAddManual = document.getElementById("cancelAddManual");

  if (addManualBtn && addManualModal) {
    addManualBtn.addEventListener("click", () => {
      addManualModal.classList.add("active");
    });
  }

  const closeManualModalFunc = () => {
    if (addManualModal) addManualModal.classList.remove("active");
  };

  if (closeAddManualModal)
    closeAddManualModal.addEventListener("click", closeManualModalFunc);
  if (cancelAddManual)
    cancelAddManual.addEventListener("click", closeManualModalFunc);

  if (addManualModal) {
    addManualModal.addEventListener("click", (e) => {
      if (e.target === addManualModal) {
        closeManualModalFunc();
      }
    });
  }

  // Dynamic Participants Logic
  const addParticipantBtn = document.getElementById(
    "admin-add-participant-btn",
  );
  const removeParticipantBtn = document.getElementById(
    "admin-remove-participant-btn",
  );
  const participantsContainer = document.getElementById(
    "admin-participants-container",
  );
  let participantCount = 1;
  const TICKET_PRICE = 80000;
  const ADMIN_FEE = 1000;

  const updateAmount = () => {
    const total =
      participantCount > 0 ? participantCount * TICKET_PRICE + ADMIN_FEE : 0;
    const manualAmountDisplay = document.getElementById(
      "manualAmountDisplay",
    ) as HTMLInputElement;
    const manualAmountValue = document.getElementById(
      "manualAmountValue",
    ) as HTMLInputElement;
    if (manualAmountDisplay)
      manualAmountDisplay.value = "Rp " + total.toLocaleString("id-ID");
    if (manualAmountValue) manualAmountValue.value = total.toString();
  };

  updateAmount(); // Initialize

  if (addParticipantBtn && removeParticipantBtn && participantsContainer) {
    addParticipantBtn.addEventListener("click", () => {
      participantCount++;
      const index = participantCount;
      const block = document.createElement("div");
      block.className = "admin-participant-block";
      block.setAttribute("data-index", index.toString());
      block.style.cssText =
        "margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px dashed rgba(255,255,255,0.1);";

      block.innerHTML = `
        <h5 style="margin-top:0; margin-bottom:1rem; color: var(--accent);">Peserta ${index}</h5>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 1rem;">
          <div class="form-group">
            <label style="display:block; margin-bottom:0.5rem;">Nama Lengkap (Sesuai ID) *</label>
            <input type="text" name="name_${index}" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;" />
          </div>
          <div class="form-group">
            <label style="display:block; margin-bottom:0.5rem;">Nomor Identitas *</label>
            <input type="text" name="nomorId_${index}" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;" />
          </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.5rem;">
          <div class="form-group">
            <label style="display:block; margin-bottom:0.5rem;">Jenis Kelamin *</label>
            <select name="jenisKelamin_${index}" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;">
              <option value="Pria">Pria</option>
              <option value="Wanita">Wanita</option>
            </select>
          </div>
          <div class="form-group">
            <label style="display:block; margin-bottom:0.5rem;">Jenis ID *</label>
            <select name="jenisId_${index}" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;">
              <option value="KTP">KTP</option>
              <option value="SIM">SIM</option>
              <option value="KTM / Kartu Pelajar">KTM / Kartu Pelajar</option>
              <option value="Paspor">Paspor</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
          <div class="form-group">
            <label style="display:block; margin-bottom:0.5rem;">Ukuran Jersey *</label>
            <select name="ukuranJersey_${index}" class="form-control" required style="width:100%; padding:0.6rem; background:#1e293b; color:white; border:1px solid #334155; border-radius:4px;">
              <option value="S">S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XL">XL</option>
              <option value="XXL">XXL</option>
            </select>
          </div>
        </div>
      `;
      participantsContainer.appendChild(block);
      if (participantCount > 1) {
        removeParticipantBtn.style.display = "inline-block";
      }
      updateAmount();
    });

    removeParticipantBtn.addEventListener("click", () => {
      if (participantCount > 1) {
        const lastBlock = participantsContainer.querySelector(
          `.admin-participant-block[data-index="${participantCount}"]`,
        );
        if (lastBlock) {
          participantsContainer.removeChild(lastBlock);
          participantCount--;
          if (participantCount <= 1) {
            removeParticipantBtn.style.display = "none";
          }
          updateAmount();
        }
      }
    });
  }

  // Handle form submission loader
  const addManualForm = document.querySelector(".manual-add-form");
  if (addManualForm) {
    addManualForm.addEventListener("submit", function () {
      const submitBtn = document.getElementById(
        "btn-submit-manual",
      ) as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.innerHTML = "⏱️ Sedang Menyimpan...";
        submitBtn.style.opacity = "0.7";
        submitBtn.style.pointerEvents = "none";
      }

      const loader = document.createElement("div");
      loader.innerHTML = `
        <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; display:flex; flex-direction:column; justify-content:center; align-items:center;">
          <div style="width:50px; height:50px; border:5px solid #fff; border-top:5px solid var(--accent); border-radius:50%; animation:spin 1s linear infinite;"></div>
          <style>@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }</style>
          <p style="color:white; margin-top:20px; font-size:1.2rem; font-weight:bold;">Sedang Memproses & Mengirim Email E-Tiket...</p>
        </div>
      `;
      document.body.appendChild(loader);
    });
  }

  // Modal Logic
  const viewProofBtns = document.querySelectorAll(".view-proof-btn");
  const modal = document.getElementById("receipt-modal");
  const modalImg = document.getElementById("modal-img") as HTMLImageElement;
  const closeModal = document.getElementById("close-modal");

  if (modal && modalImg && closeModal) {
    viewProofBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const proof = btn.getAttribute("data-proof");
        if (proof) {
          modalImg.src = proof;
          modal.classList.add("active");
        }
      });
    });

    closeModal.addEventListener("click", () => {
      modal.classList.remove("active");
      modalImg.src = "";
    });

    // Close modal on background click
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        modal.classList.remove("active");
        modalImg.src = "";
      }
    });
  }

  // File Preview & Submit Logic
  const csvFileInput = document.getElementById("csv_file") as HTMLInputElement;
  const filePreviewContainer = document.getElementById(
    "file-preview-container",
  );
  const filePreviewContent = document.getElementById("file-preview-content");
  const filePreviewName = document.getElementById("file-preview-name");
  const btnCancelImport = document.getElementById("btn-cancel-import");
  const csvFileLabel = document.getElementById("csv_file_label");
  const btnProcessImport = document.getElementById("btn-process-import");

  if (
    csvFileInput &&
    filePreviewContainer &&
    filePreviewContent &&
    filePreviewName &&
    btnCancelImport &&
    csvFileLabel
  ) {
    csvFileInput.addEventListener("change", () => {
      const file = csvFileInput.files ? csvFileInput.files[0] : null;
      if (file) {
        filePreviewName.textContent = file.name;
        filePreviewContent.innerHTML = ""; // Clear previous preview

        if (file.type.startsWith("image/")) {
          const img = document.createElement("img");
          const objUrl = URL.createObjectURL(file);
          img.src = objUrl;
          img.style.width = "40px";
          img.style.height = "40px";
          img.style.objectFit = "cover";
          img.style.borderRadius = "4px";
          img.style.cursor = "pointer";
          img.title = "Klik untuk memperbesar";
          img.addEventListener("click", () => {
            if (modal && modalImg) {
              modalImg.src = objUrl;
              modal.classList.add("active");
            }
          });
          filePreviewContent.appendChild(img);
        } else {
          const icon = document.createElement("span");
          icon.textContent = "📄";
          icon.style.fontSize = "1.5rem";
          icon.style.cursor = "pointer";
          icon.title = "Klik untuk membuka file";
          const objUrl = URL.createObjectURL(file);
          icon.addEventListener("click", () => {
            window.open(objUrl, "_blank");
          });
          filePreviewContent.appendChild(icon);
        }

        // Sembunyikan alert lama jika ada
        document.querySelectorAll(".alert").forEach((el) => {
          (el as HTMLElement).style.display = "none";
        });

        // Show preview, hide select button
        filePreviewContainer.style.display = "flex";
        csvFileLabel.style.display = "none";
      }
    });

    btnCancelImport.addEventListener("click", () => {
      // Sembunyikan alert lama
      document.querySelectorAll(".alert").forEach((el) => {
        (el as HTMLElement).style.display = "none";
      });
      csvFileInput.value = ""; // Reset input
      filePreviewContainer.style.display = "none";
      csvFileLabel.style.display = "flex";
    });

    if (btnProcessImport) {
      const form = csvFileInput.closest("form");
      if (form) {
        form.addEventListener("submit", () => {
          btnProcessImport.textContent = "Memproses...";
          btnProcessImport.setAttribute("disabled", "true");
        });
      }
    }
  }
</script>

