---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import CTA from "../components/CTA.astro";
import RuteComponent from "../components/Rute.astro";
import ParkirComponent from "../components/Parkir.astro";
import { getUpcomingEvents, getFinishedEvents, getEventById } from "../lib/db";
import { showSelamatCard } from "../config";

const upcomingEvents = await getUpcomingEvents();
const finishedEvents = await getFinishedEvents();
const mainEvent = await getEventById(1);
const isFull = true; // mainEvent ? mainEvent.registered >= 1379 : false;

// Cek apakah pendaftaran sudah dibuka (31 Juli 2026, 08:00 WIB)
const registrationOpenDate = new Date('2026-07-31T08:00:00+07:00');
const isRegistrationOpen = new Date() >= registrationOpenDate;

// Ambil list kategori unik untuk filter
const categories = [
  "Semua",
  "RUNNING",
  "CYCLING",
  "POUNDFIT",
  "WALK",
  "TRIATHLON",
];
---

<Layout
  title="Syiar QRIS Run 2026 - Event Lari Bank Indonesia Kediri"
  description="Daftar Syiar QRIS Run 2026 yang diselenggarakan oleh Bank Indonesia Kediri pada 16 Agustus 2026 di Kediri Town Square. Nikmati pengalaman lari dan dukung digitalisasi QRIS!"
  schemaType="Event"
>
  <!-- Centered Hero Section -->
  <section class="hero centered-hero">
    <div class="hero-bg-overlay"></div>

    <div class="container hero-container-centered">
      <!-- Event Logo Placeholder -->
      <div class="event-logo-wrapper">
        <img
          src="/logo.webp"
          alt="Logo SYIAR QRIS RUN"
          id="main-logo"
          class="event-hero-logo"
          width="385"
          height="152"
          fetchpriority="high"
          loading="eager"
        />
      </div>

      <!-- Date & Location -->
      <div class="event-meta-pills">
        <div class="pill date-pill glass">16 Agustus 2026</div>
        <div class="pill location-pill glass">Kediri Town Square</div>
      </div>

      <!-- Countdown -->
      <div class="countdown-wrapper">
        <p class="countdown-label">ACARA DIMULAI DALAM</p>

        <div id="countdown-timer" class="countdown-timer">
          <div class="time-box glass">
            <span class="time-num" id="cd-days">00</span>
            <span class="time-text">HARI</span>
          </div>
          <div class="time-box glass">
            <span class="time-num" id="cd-hours">00</span>
            <span class="time-text">JAM</span>
          </div>
          <div class="time-box glass">
            <span class="time-num" id="cd-minutes">00</span>
            <span class="time-text">MENIT</span>
          </div>
          <div class="time-box glass">
            <span class="time-num" id="cd-seconds">00</span>
            <span class="time-text">DETIK</span>
          </div>
        </div>

        <div
          id="event-started"
          class="event-started-box"
          style="display: none;"
        >
          <h2 class="started-text">EVENT STARTED</h2>
          <a href="/sertifikat" class="btn btn-accent btn-large"
            >Lihat Sertifikat</a
          >
        </div>

        {isFull ? (
          showSelamatCard ? (
            <div class="status-alert" style="margin: 2.5rem 0; padding: 2rem; border-radius: 24px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4); text-align: left;">
              
              <!-- Header Title -->
              <div style="text-align: center; margin-bottom: 2rem;">
                <span style="display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); font-weight: 800; font-size: 0.75rem; padding: 0.35rem 1rem; border-radius: 9999px; margin-bottom: 0.5rem; letter-spacing: 1px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8 a3 3 0 1 1-5.8-1.6"/></svg>
                  PENGUMUMAN RESMI
                </span>
                <h2 style="font-size: 1.4rem; font-weight: 800; color: #ffffff; margin: 0; letter-spacing: 0.3px;">
                  Hasil Verifikasi & Informasi Peserta
                </h2>
              </div>

              <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                <!-- BANNER 1: PESERTA TERDAFTAR (LOLOS VERIFIKASI) -->
                <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: row; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap;">
                  <div style="background: linear-gradient(135deg, #2563eb, #1d4ed8); min-width: 54px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3); flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  </div>
                  <div style="flex: 1; min-width: 260px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.4rem;">
                      <h3 style="color: #60a5fa; font-size: 1.15rem; font-weight: 800; margin: 0;">
                        Selamat untuk para runner yang berhasil terpilih mengikuti event Syiar Qris Run 2026!
                      </h3>
                      <span style="background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 6px;">
                        LOLOS VERIFIKASI
                      </span>
                    </div>
                    <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1rem;">
                      Terima kasih atas antusiasme luar biasa dari seluruh peserta! Bagi runner yang belum berkesempatan terdaftar karena kuota telah penuh, tetap semangat dan sampai jumpa di event seru berikutnya
                    </p>

                    <!-- Alert Cek Spam Box -->
                    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-left: 3px solid #f59e0b; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.83rem;">
                      <strong style="color: #fbbf24; display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.2rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        Catatan E-Tiket:
                      </strong>
                      <span style="color: #e2e8f0; line-height: 1.5;">
                        Mohon cek folder <strong>Spam / Junk / Promosi</strong> pada email Anda jika E-Tiket tidak ditemukan di Inbox.
                      </span>
                    </div>
                  </div>
                </div>

                <!-- BANNER 2: PROSES REFUND (TIDAK LOLOS VERIFIKASI) -->
                <div style="background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: row; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap;">
                  <div style="background: linear-gradient(135deg, #d97706, #b45309); min-width: 54px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(217, 119, 6, 0.3); flex-shrink: 0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                  </div>
                  <div style="flex: 1; min-width: 260px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.4rem;">
                      <h3 style="color: #fbbf24; font-size: 1.15rem; font-weight: 800; margin: 0;">
                        Informasi Pengembalian Dana (Refund)
                      </h3>
                      <span style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 6px;">
                        TIDAK LOLOS VERIFIKASI
                      </span>
                    </div>
                    <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.6; margin-bottom: 1rem;">
                      Kepada seluruh peserta yang tidak lolos verifikasi, akan dilakukan proses refund. Mohon mengirimkan nomor rekening melalui WhatsApp admin yang tersedia untuk proses transfer pengembalian dana.
                    </p>

                    <!-- Details & Button Grid -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; align-items: center;">
                      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.82rem; color: #e2e8f0;">
                        <strong style="color: #fbbf24; display: block; margin-bottom: 0.3rem;">Data Rekening yang Dikirimkan:</strong>
                        • Nilai Uang Transfer<br />
                        • Nama Bank & Nomor Rekening<br />
                        • Atas Nama Pemilik Rekening
                      </div>

                      <a href="/kontak" class="btn btn-sm" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; text-align: center; background-color: #f59e0b; color: #0f172a; font-weight: 800; padding: 0.8rem 1.25rem; border-radius: 10px; text-decoration: none; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.25);">
                        Hubungi Admin WhatsApp
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                      </a>
                    </div>
                  </div>
                </div>

              </div>

            </div>
          ) : (
            <button
              class="btn btn-large"
              style="margin-top: 2rem; margin-bottom: 2rem; background-color: #6b7280; color: white; cursor: not-allowed; opacity: 0.8;"
              disabled>Kuota Penuh</button>
          )
        ) : isRegistrationOpen ? (
          <a
            href="/events/1"
            class="btn btn-accent btn-large"
            style="margin-top: 2rem; margin-bottom: 2rem;">Daftar Sekarang</a>
        ) : (
          <button
            class="btn btn-large"
            style="margin-top: 2rem; margin-bottom: 2rem; background-color: #6b7280; color: white; cursor: not-allowed; opacity: 0.8;"
            disabled>Dibuka 31 Juli 2026</button>
        )}

        {!isFull && (
          <p class="kuota-text" style="color: white;">
            Kuota 1500 Peserta! daftar Sekarang Juga Sebelum Kuota Terpenuhi.
          </p>
        )}
      </div>
    </div>

    <!-- Static Sponsors Bottom Bar -->
    <div class="sponsors-bar">
      <p class="sponsors-title"></p>
      <div class="sponsor-marquee">
        <div class="sponsor-track">
          <img src="/logo_sponsor.webp" alt="Logo Sponsor Syiar QRIS Run" class="sponsor-logo" width="200" height="100" loading="lazy" />
          <img src="/logo_sponsor.webp" alt="Logo Sponsor Syiar QRIS Run" class="sponsor-logo" width="200" height="100" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about-section" id="about">
    <div class="container about-container">
      <div class="about-content">
        <h2 class="about-title">Syiar QRIS Run 2026</h2>
        <p class="about-desc">
          <strong>Syiar QRIS Run 2026</strong> merupakan ajang lari yang diselenggarakan
          oleh <strong>Bank Indonesia Kediri</strong> untuk mengajak masyarakat menerapkan
          gaya hidup sehat sekaligus mendukung percepatan digitalisasi sistem pembayaran
          melalui QRIS.
        </p>
        <p class="about-desc">
          Tak hanya berlari untuk kesehatan, setiap transaksi QRIS yang Anda
          lakukan juga menjadi bagian dari <strong>gerakan berwakaf</strong>,
          menghadirkan manfaat yang terus mengalir bagi sesama.
        </p>
        <p class="about-desc">
          Melalui semangat <em
            >"Berlari, Berwakaf, dan Bertransaksi dengan QRIS"</em
          >, setiap langkah dan setiap transaksi menjadi bagian dari <strong
            >gerakan kebaikan</strong
          > yang memberikan manfaat bagi sesama.
        </p>
        <p class="about-desc">
          Mari dukung <strong>percepatan digitalisasi pembayaran</strong> sekaligus 
          <strong>menebarkan kebaikan</strong> dalam setiap langkah. Mari Berlari,
          Berbagi, dan Memberi Arti.
        </p>
      </div>
      <div class="about-image-wrapper">
        <img
          src="/about-image-placeholder.webp"
          alt="Syiar QRIS Run 2026 Poster"
          class="about-image"
          width="634"
          height="792"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Benefit Section -->
  <section class="benefit-section" id="benefit">
    <div class="container benefit-container">
      <h2 class="benefit-title">Fasilitas</h2>

      <div class="benefit-grid">
        <div class="benefit-card glass">
          <img src="/benefit-bib.webp" alt="Nomor BIB" class="benefit-icon" width="88" height="88" loading="lazy" />
          <p class="benefit-text">Nomor BIB</p>
        </div>

        <div class="benefit-card glass">
          <img
            src="/benefit-jersey.webp"
            alt="Jersey Official"
            class="benefit-icon"
            width="88"
            height="88"
            loading="lazy"
          />
          <p class="benefit-text">Jersey Official</p>
        </div>

        <div class="benefit-card glass">
          <img
            src="/benefit-medal.webp"
            alt="Finisher Medal"
            class="benefit-icon"
            width="88"
            height="88"
            loading="lazy"
          />
          <p class="benefit-text">Finisher Medal</p>
        </div>

        <div class="benefit-card glass">
          <img
            src="/benefit-doorprize.webp"
            alt="Doorprize"
            class="benefit-icon"
            width="88"
            height="88"
            loading="lazy"
          />
          <p class="benefit-text">Doorprize</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Rute Section -->
  <RuteComponent />

  <!-- Lahan Parkir Section -->
  <ParkirComponent />

    <CTA />

    <!-- FAQ Section -->
    <section class="faq-section" id="faq">
      <div class="container faq-container">
        <div class="section-header center">
          <!-- <span class="badge-pill">SUPPORT CENTER</span> -->
          <h2 class="section-title">Pertanyaan Seputar Event</h2>
          <p class="section-subtitle">
            Temukan jawaban atas pertanyaan umum seputar Syiar QRIS Run 2026 di
            sini.
          </p>
        </div>

        <div class="faq-grid">
          <div class="faq-item glass">
            <button class="faq-question">
              <span>Apa itu Syiar QRIS Run ?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Syiar QRIS Run adalah event lari rekreasi yang menggabungkan
                gaya hidup sehat dan kepedulian sosial.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Siapa saja yang boleh ikut?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Event ini terbuka untuk umum, dari anak-anak hingga dewasa, baik
                pelari pemula maupun profesional.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Di mana lokasi start dan finish?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>Start dan finish akan dilakukan di Kediri Town Square.</p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Fasilitas apa saja yang didapat peserta?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Peserta akan mendapatkan Nomor BIB, Jersey Official, Finisher
                Medal, dan kesempatan Doorprize.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Bagaimana cara mendaftar?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Anda bisa mendaftar secara online melalui website ini dengan
                menekan tombol "Daftar Sekarang".
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Bagaimana jika saya datang terlambat?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Peserta yang terlambat setelah flag-off tidak diperkenankan
                mengikuti lari dan tidak mendapatkan hak finisher.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Apakah boleh membawa hewan peliharaan?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Demi kenyamanan dan keamanan bersama, peserta tidak
                diperkenankan membawa hewan peliharaan.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Apa yang menyebabkan event dihentikan?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Event dapat dihentikan jika terjadi kondisi force majeure
                seperti cuaca ekstrem atau bencana alam.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Apa penyebab peserta didiskualifikasi?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Peserta dapat didiskualifikasi jika memotong rute, menggunakan
                kendaraan, atau tindakan tidak sportif.
              </p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Kapan pengambilan racepack?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>Pengambilan racepack dilakukan pada <strong>Jumat - Sabtu, 14-15 Agustus 2026</strong>, pukul <strong>09:00 - 18:00 WIB</strong>.</p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Di mana peserta dapat melakukan pengambilan racepack?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>Pengambilan racepack dapat dilakukan di Halaman Kantor Wilayah Bank Indonesia Kediri, Jalan Brawijaya No.2, Pocanan, Kecamatan Kota, Kota Kediri, Jawa Timur.</p>
              <p><strong>Catatan:</strong> Tidak melayani pengambilan racepack di Kediri Town Square (Lokasi Acara)</p>
            </div>
          </div>

          <div class="faq-item glass">
            <button class="faq-question">
              <span>Apakah pengambilan racepack bisa diwakilkan?</span>
              <span class="faq-icon">↓</span>
            </button>
            <div class="faq-answer">
              <p>
                Bisa. Pengambilan dapat diwakilkan dengan membawa bukti pendaftaran E-Tiket, fotokopi KTP peserta, serta Surat Kuasa yang dapat diunduh melalui <a href="https://drive.google.com/drive/folders/1sHk1ZjX_PyX-X6M3LJ6Ux04M9ak6W8Xm?usp=sharing" target="_blank" rel="noopener noreferrer" style="color: #60a5fa; text-decoration: underline;">tautan Google Drive ini</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Kategori Filter -->
    <!-- <section class="sticky-filter glass">
  <!-- Gallery Section (Disiapkan jika klien butuh) -->
  <!-- <section class="gallery-section" id="gallery">
    <div class="container gallery-container">
      <div class="section-header center">
        <h2 class="section-title">Galeri Event</h2>
        <p class="section-subtitle">
          Momen-momen seru dari event Syiar QRIS Run sebelumnya.
        </p>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item glass">
          <img src="/gallery-placeholder-1.webp" alt="Galeri 1" class="gallery-image" width="400" height="300" loading="lazy" />
        </div>
