          <img src="/gallery-placeholder-2.webp" alt="Galeri 2" class="gallery-image" width="400" height="300" loading="lazy" />
        </div>
        <div class="gallery-item glass">
          <img src="/gallery-placeholder-3.webp" alt="Galeri 3" class="gallery-image" width="400" height="300" loading="lazy" />
        </div>
        <div class="gallery-item glass">
          <img src="/gallery-placeholder-4.webp" alt="Galeri 4" class="gallery-image" width="400" height="300" loading="lazy" />
        </div>
        <div class="gallery-item glass">
          <img src="/gallery-placeholder-5.webp" alt="Galeri 5" class="gallery-image" width="400" height="300" loading="lazy" />
        </div>
        <div class="gallery-item glass">
          <img src="/gallery-placeholder-6.webp" alt="Galeri 6" class="gallery-image" width="400" height="300" loading="lazy" />
        </div>
      </div>
    </div>
  </section> -->

