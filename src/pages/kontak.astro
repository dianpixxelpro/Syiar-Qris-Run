<style>
  .section-padding {
    padding: 80px 0;
  }

  .text-accent {
    color: var(--accent);
  }

  .italic {
    font-style: italic;
  }

  .badge-blue {
    display: inline-block;
    background-color: rgba(43, 73, 143, 0.3);
    border: 1px solid #4a72d6;
    color: #9bbcf2;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  /* Kontak Section */
  .kontak-section {
    background-color: #ffffff; /* White background */
    padding-top: 120px; /* Memberi ruang untuk navbar */
  }

  .kontak-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .kontak-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: #111827; /* Dark text for title */
  }

  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #374151; /* Darker gray for subtitle */
    max-width: 650px;
    margin: 0 auto;
  }

  /* Kontak Card */
  .kontak-card {
    background: #f8fafc; /* Light gray card background */
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-lg);
    padding: 3rem;
    margin-bottom: 3rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .contact-icon-wrapper {
    width: 48px;
    height: 48px;
    background-color: rgba(43, 73, 143, 0.5); /* Biru gelap transparan */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-icon {
    font-size: 1.3rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: #4b5563; /* Darker gray for label */
    text-transform: uppercase;
  }

  .contact-value {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111827; /* Dark text for value */
    margin: 0;
  }

  /* Social Section */
  .social-section {
    text-align: center;
  }

  .social-label {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text-secondary);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .social-icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--neutral-white);
    text-decoration: none;
    transition: all 0.2s;
    font-size: 1.1rem;
  }

  .social-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-3px);
  }

  /* Map Section */
  .map-section {
    background-color: #cbd5e1; /* Match CTA background */
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #111827; /* Dark text for title */
  }

  .maps-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.2s;
    margin-bottom: 0.5rem;
  }

  .maps-link:hover {
    opacity: 0.8;
  }

  .external-icon {
    font-size: 1.2rem;
  }

  .map-container {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: #1a1a2e; /* Placeholder warna gelap */
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  .map-center-label {
    position: absolute;
    right: 12px;
    bottom: 12px;
    transform: none;
    background: rgba(2, 6, 23, 0.75);
    color: #fff;
    padding: 0.45rem 0.75rem;
    border-radius: 10px;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-weight: 700;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .map-center-label .pin {
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.2rem;
    }

    .kontak-card {
      padding: 2rem 1.5rem;
    }

    .map-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .map-container {
      height: 300px;
    }
    .map-center-label {
      padding: 0.35rem 0.6rem;
      font-size: 0.95rem;
      right: 10px;
      bottom: 10px;
    }
  }
</style>
