---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import { showSelamatCard } from "../config";

interface Props {
  title: string;
  description?: string;
  image?: string;
  schemaType?: "Event" | "WebSite" | "Article" | "Organization";
  noindex?: boolean;
}

// Cek apakah pendaftaran sudah dibuka (31 Juli 2026, 08:00 WIB)
const registrationOpenDate = new Date("2026-07-31T08:00:00+07:00");
const isRegistrationOpen = new Date() >= registrationOpenDate;

const {
  title,
  description = "Syiar QRIS Run 2026 adalah ajang lari resmi yang diselenggarakan oleh Bank Indonesia Kediri di Kediri Town Square pada 16 Agustus 2026. Daftar sekarang untuk mendukung digitalisasi pembayaran QRIS dan gaya hidup sehat!",
  image = "/logo.webp",
  schemaType = "WebSite",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="id" style="overflow-x: clip;">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      image={image}
      schemaType={schemaType}
      noindex={noindex}
    />
  </head>
  <body style="overflow-x: clip; position: relative; width: 100%;">
    <header class="header glass">
      <div class="container header-container">
        <!-- Logo Image Placeholder -->
        <a href="/" class="logo">
          <img
            src="/logo.webp"
            alt="Logo Syiar QRIS Run"
            id="main-logo"
            class="navbar-logo-img"
            width="180"
            height="71"
            fetchpriority="high"
          />
        </a>

        <nav class="nav">
          <a href="/" class="nav-link">Beranda</a>

          <div class="nav-dropdown">
            <button class="nav-link dropdown-toggle" aria-expanded="false"
              >Informasi <span class="arrow">▾</span></button
            >
            <div class="dropdown-menu">
              <a href="/jersey" class="dropdown-item">Jersey</a>
              <a href="/medali" class="dropdown-item">Medali</a>
              <a href="/rute" class="dropdown-item">Rute</a>
              <a href="/panduan" class="dropdown-item">Panduan Pendaftaran</a>
            </div>
          </div>

          <a href="/regulasi" class="nav-link">Regulasi</a>
          <a href="/kontak" class="nav-link">Kontak</a>
        </nav>

        <div class="header-actions">
          {!showSelamatCard && (
            <a
              href="/cek-status"
              class="btn btn-outline btn-sm"
              style="padding: 0.5rem 1.25rem; font-size: 0.9rem; font-weight: 700; border-radius: 9999px; border: 1px solid var(--accent); color: var(--accent);"
              >Cek Status</a
            >
          )}
          <button
            class="mobile-menu-btn"
            id="mobile-menu-toggle"
            aria-label="Toggle Menu"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <!-- Mobile Nav -->
      <div class="mobile-nav" id="mobile-nav">
        <a href="/" class="mobile-nav-link">Beranda</a>
        <button
          class="mobile-nav-link"
          id="mobile-info-toggle"
          style="width: 100%; text-align: left; background: none; border: none; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: inherit; font-family: inherit; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0;"
        >
          Informasi <span
            class="arrow"
            style="font-size: 0.8em; transition: transform 0.2s;">▾</span
          >
        </button>
        <div
          class="mobile-dropdown-menu"
          id="mobile-info-menu"
          style="display: none; flex-direction: column; padding-left: 1.5rem; background: rgba(0,0,0,0.1); border-bottom: 1px solid rgba(255, 255, 255, 0.05);"
        >
          <a
            href="/jersey"
            class="mobile-nav-link"
            style="border-bottom: 1px dashed rgba(255,255,255,0.05); font-size: 1rem;"
            >Jersey</a
          >
          <a
            href="/medali"
            class="mobile-nav-link"
            style="border-bottom: 1px dashed rgba(255,255,255,0.05); font-size: 1rem;"
            >Medali</a
          >
          <a
            href="/rute"
            class="mobile-nav-link"
            style="border-bottom: 1px dashed rgba(255,255,255,0.05); font-size: 1rem;"
            >Rute</a
          >
          <a
            href="/panduan"
            class="mobile-nav-link"
            style="border-bottom: none; font-size: 1rem;">Panduan Pendaftaran</a
          >
        </div>
        <a href="/regulasi" class="mobile-nav-link">Regulasi</a>
        <a href="/kontak" class="mobile-nav-link">Kontak</a>
        <!-- <a href="/events/1" class="mobile-nav-link" style="background-color: var(--accent-bright); color: var(--bg-primary) !important; padding: 0.8rem 1rem; border-radius: 12px; text-align: center; margin-top: 1rem; border-bottom: none; font-weight: 800; display: block; white-space: nowrap;">Daftar Sekarang</a> -->
        <div
          style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;"
        >
          {
            isRegistrationOpen ? (
              <a
                href="/events/1"
                class="mobile-nav-link"
                style="width: 100%; background-color: var(--accent-bright); color: var(--bg-primary) !important; padding: 0.8rem; border-radius: 12px; text-align: center; font-weight: 800; display: block; white-space: nowrap; margin-top: 0;"
              >
                Daftar Sekarang
              </a>
            ) : (
              <button
                class="mobile-nav-link"
                style="width: 100%; background-color: #6b7280; color: white !important; padding: 0.8rem; border-radius: 12px; text-align: center; font-weight: 800; display: block; white-space: nowrap; cursor: not-allowed; opacity: 0.8; border: none; margin-top: 0;"
                disabled
              >
                Dibuka 31 Juli 2026
              </button>
            )
          }
          {
            !showSelamatCard && (
              <a
                href="/cek-status"
                class="mobile-nav-link"
                style="width: 100%; background-color: transparent; border: 1px solid var(--accent); color: var(--accent) !important; padding: 0.8rem; border-radius: 12px; text-align: center; font-weight: 800; display: block; white-space: nowrap; margin-top: 0;"
                >Cek Status</a
              >
            )
          }
        </div>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="footer glass">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="logo">
            <img
              src="/logo.webp"
              alt="Logo Syiar QRIS Run"
              class="navbar-logo-img"
              width="180"
              height="71"
              loading="lazy"
            />
          </div>
          <p class="footer-desc">
            Syiar QRIS Run 2026 merupakan ajang lari yang diselenggarakan oleh
            Bank Indonesia Kediri untuk mengajak masyarakat menerapkan gaya
            hidup sehat sekaligus mendukung percepatan digitalisasi sistem
            pembayaran melalui QRIS.
          </p>
        </div>
        <div class="footer-links">
          <h3>Informasi</h3>
          <a href="/">Beranda</a>
          <a href="/jersey">Jersey</a>
          <a href="/medali">Medali</a>
          <a href="/rute">Rute</a>
        </div>
        <div class="footer-links">
          <h3 style="visibility: hidden;">Layanan</h3>
          <a href="/panduan">Panduan</a>
          <a href="/events/1">Daftar Event</a>
          <a href="/regulasi">Regulasi</a>
          <a href="/kontak">Kontak</a>
        </div>
        <div class="footer-social">
          <h3>Ikuti Kami</h3>
          <div class="social-icons">
            <a
              href="https://youtube.com/@bankindonesiakediri"
              aria-label="YouTube"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M2.5 7.1c.3-1.5 1.5-2.7 3-3 2.5-.5 6.5-.5 6.5-.5s4 0 6.5.5c1.5.3 2.7 1.5 3 3 .5 2.5.5 4.9.5 4.9s0 2.4-.5 4.9c-.3 1.5-1.5 2.7-3 3-2.5.5-6.5.5-6.5.5s-4 0-6.5-.5c-1.5-.3-2.7-1.5-3-3-.5-2.5-.5-4.9-.5-4.9s0-2.4.5-4.9z"
                ></path><path d="m10 15 5-3-5-3v6z"></path></svg
              >
            </a>
            <a
              href="https://x.com/KPwBi_kediri"
              aria-label="X (Twitter)"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path
                  d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg
              >
            </a>
            <a
              href="https://instagram.com/bank_indonesia_kediri"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"
                ></rect><path
                  d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                ></line></svg
              >
            </a>
            <a
              href="https://tiktok.com/@bank.indonesia.ke"
              aria-label="TikTok"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path><path
                  d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Syiar QRIS Run. All rights reserved.</p>
      </div>
    </footer>

    <!-- Floating WhatsApp Button -->
    <div class="floating-wa-container">
      <div class="floating-wa-menu">
        <!-- <a href="https://wa.me/628815083790" class="wa-item" target="_blank" rel="noopener noreferrer">Galih</a> -->
        <!-- <a href="https://wa.me/6281947731307" class="wa-item" target="_blank" rel="noopener noreferrer">Galuh</a> -->
        <!-- <a href="https://wa.me/628132942336" class="wa-item" target="_blank" rel="noopener noreferrer">Rere</a> -->
        <a href="https://wa.me/6288991110710" class="wa-item" target="_blank" rel="noopener noreferrer">Galang</a>
        <a href="https://wa.me/6282335096399" class="wa-item" target="_blank" rel="noopener noreferrer">Alex</a>
        <!-- <a href="https://wa.me/6289671961384" class="wa-item" target="_blank" rel="noopener noreferrer">Mila</a> -->
        <a href="https://wa.me/6285877049291" class="wa-item" target="_blank" rel="noopener noreferrer">Dimas</a>
      </div>
      <button class="floating-wa" aria-label="Hubungi kami via WhatsApp">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
      </button>
    </div>

    <script>
      const toggleBtn = document.getElementById("mobile-menu-toggle");
      const mobileNav = document.getElementById("mobile-nav");

      if (toggleBtn && mobileNav) {
        toggleBtn.addEventListener("click", () => {
          mobileNav.classList.toggle("active");
          toggleBtn.classList.toggle("active");
        });
      }

      const infoToggle = document.getElementById("mobile-info-toggle");
      const infoMenu = document.getElementById("mobile-info-menu");
      if (infoToggle && infoMenu) {
        infoToggle.addEventListener("click", () => {
          const arrow = infoToggle.querySelector<HTMLElement>(".arrow");
          if (infoMenu.style.display === "none") {
            infoMenu.style.display = "flex";
            if (arrow) arrow.style.transform = "rotate(180deg)";
          } else {
            infoMenu.style.display = "none";
            if (arrow) arrow.style.transform = "rotate(0deg)";
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* Header Styles */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    height: 72px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    background:
      linear-gradient(
        to bottom right,
        var(--bg-primary) 0%,
        #201a4e 40%,
        var(--primary) 100%
      ),
      rgba(43, 119, 223, 0.5);
    background-blend-mode: overlay;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .navbar-logo-img {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  /* Dropdown Styles */
  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-toggle {
    background: none;
    border: none;
    color: inherit;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: rgba(
      43,
      119,
      223,
      0.95
    ); /* Match navbar color but more opaque */
    min-width: 160px;
    box-shadow: var(--shadow-md);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 1000;
    padding: 0.5rem 0;
  }

  .nav-dropdown:hover .dropdown-menu {
    display: block;
  }

  .dropdown-menu a {
    color: #ffffff; /* White text for dropdown items */
    padding: 0.75rem 1.5rem;
    display: block;
    font-size: 0.9rem;
    transition: background 0.2s;
  }

  .dropdown-menu a:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--accent-bright);
  }

  .nav-link.btn-buy-ticket {
    background: var(--accent-bright);
    color: var(--bg-primary) !important;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    font-weight: 800;
    margin-left: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 8px 18px rgba(232, 186, 70, 0.22);
  }
  .nav-link.btn-buy-ticket:hover {
    box-shadow: var(--shadow-accent);
    transform: translateY(-2px);
  }
  .desktop-only {
    display: none;
  }
  @media (min-width: 768px) {
    .desktop-only {
      display: inline-block;
    }
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff; /* White text for navbar links */
    padding: 0.5rem 0.25rem;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-bright);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent-bright);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .admin-tag {
    color: var(--primary);
  }
  .admin-tag:hover {
    color: #60a5fa;
  }
  .admin-tag::after {
    background-color: var(--primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .admin-btn {
    padding: 0.5rem 1.2rem;
    font-size: 0.85rem;
    border-color: var(--primary);
    color: var(--primary);
  }
  .admin-btn:hover {
    background-color: rgba(45, 130, 255, 0.1);
    border-color: var(--primary);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 101;
  }

  .mobile-menu-btn span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-nav {
    display: flex;
    position: fixed;
    top: 72px;
    right: 0;
    transform: translateX(100%);
    visibility: hidden;
    width: 280px;
    height: calc(100vh - 72px);
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
    padding: 1.5rem;
    padding-bottom: 4rem; /* Extra padding to prevent button cutoff */
    flex-direction: column;
    gap: 1.25rem;
    z-index: 99;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    box-shadow: -5px 0 15px rgba(0, 0, 0, 0.3);
  }

  .mobile-nav.active {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-nav-link {
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Main content */
  .main-content {
    min-height: calc(100vh - 72px - 300px);
  }

  /* Footer Styles */
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
    margin-top: 0;
    position: relative;
    z-index: 10;
    background:
      linear-gradient(
        to bottom right,
        var(--bg-primary) 0%,
        #201a4e 40%,
        var(--primary) 100%
      ),
      rgba(43, 119, 223, 0.5);
    background-blend-mode: overlay;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-desc {
    color: #ffffff;
    font-size: 0.95rem;
    max-width: 320px;
  }

  .footer-links,
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-links h3,
  .footer-social h3 {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    color: #ffffff;
    font-size: 0.95rem;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .social-icons {
    display: flex;
    gap: 1rem;
  }

  .social-icons a {
    width: 36px;
    height: 36px;
    border-radius: 8px; /* Rounded square */
    background-color: var(--bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white; /* White icon color */
  }

  .social-icons a:hover {
    background-color: var(--accent);
    color: #000;
    box-shadow: var(--shadow-accent);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: #ffffff;
    font-size: 0.85rem;
  }

  /* Floating WhatsApp Button */
  .floating-wa-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 1000;
    display: flex;
