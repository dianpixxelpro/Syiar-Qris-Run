---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Admin Dashboard | Syiar QRIS Run" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <title>{title} - Admin - Syiar QRIS Run 2026</title>
  </head>
  <body class="admin-body">
    <div class="admin-layout">
      <!-- Sidebar -->
      <aside class="admin-sidebar glass">
        <div class="sidebar-header">
          <a href="/mlebuodewe/admin" class="logo">
            <span class="logo-text">Syiar QRIS <span class="text-accent">Admin</span></span>
          </a>
          <button id="mobile-menu-btn" class="mobile-menu-btn" aria-label="Toggle Menu">
            ☰
          </button>
        </div>
        
        <nav class="sidebar-nav">
          <a href="/mlebuodewe/admin" class={`sidebar-link ${currentPath === '/mlebuodewe/admin' || currentPath === '/mlebuodewe/admin/' ? 'active' : ''}`}>
            <span class="icon">📊</span>
            Dashboard
          </a>
          <a href="/mlebuodewe/admin/events" class={`sidebar-link ${currentPath.includes('/mlebuodewe/admin/events') || currentPath.includes('/mlebuodewe/admin/add') || currentPath.includes('/mlebuodewe/admin/edit') ? 'active' : ''}`}>
            <span class="icon">🏃</span>
            Kelola Event
          </a>
          <a href="/mlebuodewe/admin/registrations" class={`sidebar-link ${currentPath.includes('/mlebuodewe/admin/registrations') ? 'active' : ''}`}>
            <span class="icon">👥</span>
            Pendaftar Masuk
          </a>
          <a href="/mlebuodewe/admin/checkin" class={`sidebar-link ${currentPath.includes('/mlebuodewe/admin/checkin') ? 'active' : ''}`}>
            <span class="icon">✅</span>
            Check-In Peserta
          </a>
          <a href="/mlebuodewe/admin/refunds" class={`sidebar-link ${currentPath.includes('/mlebuodewe/admin/refunds') ? 'active' : ''}`}>
            <span class="icon">💸</span>
            Kelola Refund
          </a>

        </nav>

        <div class="sidebar-footer">
          <a href="/" class="sidebar-link back-link" target="_blank">
            <span class="icon">🌐</span>
            Lihat Website
          </a>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="admin-content">
        <div class="top-nav-actions">
          <a href="/mlebuodewe/logout" class="btn-logout text-danger">
            <span class="icon">🚪</span>
            Logout
          </a>
        </div>
        <slot />
      </main>
    </div>

    <style>
      .admin-body {
        margin: 0;
        padding: 0;
        overflow-x: clip;
        background: #0f172a !important;
        color: var(--text-primary);
        font-family: var(--font-sans);
        width: 100%;
        min-height: 100vh;
      }

      .admin-layout {
        display: flex;
        min-height: 100vh;
        width: 100%;
      }

      /* Sidebar Styles */
      .admin-sidebar {
        width: 220px;
        min-height: 100vh;
        background: #1e293b;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
      }

      .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }
      
      .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        color: var(--text-primary);
        font-size: 1.5rem;
        cursor: pointer;
      }
      
      .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
      }
      
      .logo-icon {
        background: linear-gradient(135deg, var(--accent), var(--primary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.5rem;
      }
      
      .logo-text {
        font-family: var(--font-display);
        font-weight: 900;
        font-size: 1.25rem;
        letter-spacing: -0.02em;
        color: var(--text-primary);
      }
      
      .logo-text span {
        color: var(--accent);
      }

      .sidebar-nav {
        flex: 1;
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .sidebar-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-radius: var(--radius-md);
        color: var(--text-secondary);
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
      }

      .sidebar-link:hover {
        background: rgba(0, 229, 255, 0.1);
        color: var(--accent);
      }

      .sidebar-link .icon {
        font-size: 1.2rem;
      }

      .sidebar-footer {
        padding: 1.5rem 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }

      .back-link {
        background: rgba(255, 255, 255, 0.03);
      }
      .back-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-primary);
      }

      /* Content Area */
      .admin-content {
        flex: 1;
        margin-left: 220px;
        min-height: 100vh;
        background: transparent;
        padding: 0 0 2rem 0;
      }

      .top-nav-actions {
        display: flex;
        justify-content: flex-end;
        padding: 1.5rem 2rem 0;
        margin-bottom: -1rem;
        position: relative;
        z-index: 50;
      }

      .btn-logout {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.2rem;
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: var(--radius-sm);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
      }

      .btn-logout:hover {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
      }

      @media (max-width: 1024px) {
        .admin-sidebar {
          width: 200px;
        }
        .admin-content {
          margin-left: 200px;
        }
      }

      @media (max-width: 768px) {
        .admin-layout {
          flex-direction: column;
        }
        .admin-sidebar {
          width: 100%;
          min-height: auto;
          position: relative;
          border-right: none;
          border-bottom: 1px solid var(--border-color);
        }
        .admin-content {
          margin-left: 0;
          padding-top: 1rem;
          width: 100%;
          max-width: 100vw;
        }
        .sidebar-header {
          padding: 1rem 1.5rem;
        }
        .mobile-menu-btn {
          display: block;
        }
        .sidebar-nav {
          display: none;
          flex-direction: column;
          padding: 1rem;
          width: 100%;
          background: #1e293b;
          border-bottom: 1px solid var(--border-color);
        }
        .sidebar-nav.active {
          display: flex;
        }
        .sidebar-link {
          padding: 0.75rem 1rem;
        }
        .sidebar-footer {
          display: none;
        }
      }
    </style>
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const nav = document.querySelector('.sidebar-nav');
        if (btn && nav) {
          btn.addEventListener('click', () => {
            nav.classList.toggle('active');
          });
        }
      });
    </script>
  </body>
</html>
